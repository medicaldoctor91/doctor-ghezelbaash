---
import {CANONICAL, SOURCE} from './index.astro';

export const prerender = true;
const origin = SOURCE.canonicalOrigin;
const canonical = origin + '/media-license';
const stylesheet = CANONICAL.assets.find(asset => asset.type.startsWith('text/css;')).path;
const images = SOURCE.graph['@graph'].filter(node => node.acquireLicensePage === canonical);
if (images.length !== 5) throw new Error('Expected exactly five canonical media-license images');
const caption = node => {
  const values = Array.isArray(node.name) ? node.name : [node.name];
  const selected = values.find(value => value?.['@language'] === 'fa') ?? values.find(value => value?.['@language'] === 'en') ?? values[0];
  return typeof selected === 'string' ? selected : selected?.['@value'] ?? node['@id'];
};
---
<!doctype html>
<html lang="fa-IR" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <title>مجوز و اعتبار تصاویر کلینیک | دکتر سعید قزلباش</title>
    <meta name="description" content="اطلاعات مجوز، انتساب و نحوهٔ استفاده از تصاویر فضای داخلی، پذیرش و نشان کلینیک زیبایی دکتر سعید قزلباش." />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href={canonical} />
    <link href="/favicon.png" rel="icon" sizes="192x192" type="image/png" />
    <link href={stylesheet} rel="stylesheet" />
  </head>
  <body lang="fa-IR" dir="rtl">
    <a class="skip-link" href="#main-content">پرش به محتوای اصلی</a>
    <main id="main-content" tabindex="-1">
      <article class="medical-guide" lang="fa-IR" dir="rtl" aria-labelledby="media-license-title">
        <h1 id="media-license-title">مجوز و اعتبار تصاویر کلینیک</h1>
        <p>این صفحه، مقصد رسمی <bdi dir="ltr">acquireLicensePage</bdi> برای پنج تصویرِ فضای داخلی، پذیرش و نشان کلینیک است. اطلاعات هر تصویر از گراف کانونیکال وب‌سایت گرفته می‌شود.</p>
        <h2>مجوز و انتساب</h2>
        <p>این تصاویر در داده‌های ساختاریافتهٔ سایت با مجوز <a href="https://creativecommons.org/licenses/by/4.0/" rel="license external noopener">Creative Commons Attribution 4.0 International (CC BY 4.0)</a> ثبت شده‌اند. استفادهٔ مجدد باید با شرایط مجوز همان تصویر، ذکر انتساب مناسب و اعلام تغییرات احتمالی سازگار باشد. این صفحه هیچ حق یا مجوز اضافی خارج از مجوز ثبت‌شده ایجاد نمی‌کند.</p>
        <h2>تصاویر مشمول</h2>
        <ul>
          {images.map(image => <li>
            <a href={image.contentUrl}>{caption(image)}</a>
            <span> — انتساب: {image.creditText}</span>
            <span> — <a href={image.license} rel="license external noopener">متن مجوز</a></span>
          </li>)}
        </ul>
        <h2>درخواست اطلاعات یا مجوز تکمیلی</h2>
        <p>برای پرسش دربارهٔ منشأ یک تصویر، شرایط استفاده یا مجوزی متفاوت از شرایط ثبت‌شده، با <a href="mailto:doctor@ghezelbaash.ir">doctor@ghezelbaash.ir</a> تماس بگیرید و شناسه یا نشانی تصویر را ذکر کنید.</p>
        <p><a href="/">بازگشت به صفحهٔ اصلی</a> · <a href="/dr-saeed-ghezelbash-aesthetic-clinic-kermanshah">اطلاعات کلینیک</a></p>
      </article>
    </main>
  </body>
</html>
