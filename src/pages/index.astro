---
/**
 * Authoritative fixed corpus: facts, HTML, route ownership, contextual schema,
 * design and progressive reader are rendered here; canonical/source.mjs owns truth.
 * Named exports are build APIs. Infrastructure may materialize them; it must
 * not maintain another fact registry, route list or page-schema override.
 * HTTP configuration, binary assets, credentials and the Astro toolchain are
 * infrastructure responsibilities, not executable guarantees of this document.
 */
import { parse, parseFragment, serialize, serializeOuter } from "parse5";
import { createHash } from "node:crypto";
import { deriveRoutingRows, renderRobotsTxt } from "../lib/delivery-output.mjs";
import {serializeInlineJsonLd} from "../lib/jsonld.mjs";
import {closeSearchReferences, renderMedicalTrust} from "../lib/search-contract.mjs";
export const prerender = true;
import {SOURCE, AUTHORED_BODY} from "../canonical/source.mjs";
export {SOURCE, AUTHORED_BODY};
export const DESIGN = `

@font-face {
  font-family: "Vazirmatn";
  src: url("/fonts/vazirmatn-nl-wght.woff2") format("woff2");
  font-style: normal;
  font-weight: 100 900;
  font-display: optional;
}
:root {
  color-scheme: light;
  font-family:
    "Vazirmatn",
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    Tahoma,
    Arial,
    sans-serif;
  color: #14211d;
  background: #f4f7f5;
  font-synthesis: none;
  --ink: #14211d;
  --muted: #64716b;
  --line: #d9e3de;
  --surface: #ffffff;
  --surface-soft: #f6f8f6;
  --accent: #0a6b58;
  --accent-strong: #064d40;
  --accent-soft: #e7f3ef;
  --shadow: 0 24px 70px rgb(17 53 42 / 0.09);
  --radius: 1rem;
  --page-measure: 64rem;
  --reading-measure: 100%;
  --glass-line: rgb(255 255 255 / 0.78);
  --glass-shadow-soft: 0 10px 28px rgb(17 53 42 / 0.09);
}
* {
  box-sizing: border-box;
}
html {
  overflow-wrap: break-word;
  background: #f4f7f5;
}
body {
  margin: 0;
  background:
    radial-gradient(circle at 82% -8%, rgb(10 107 88 / 0.075), transparent 25rem),
    #f4f7f5;
  color: var(--ink);
  font-size: clamp(1rem, 0.94rem + 0.18vw, 1.08rem);
  line-height: 1.92;
}
main,
.guide-reader {
  container: page-shell / inline-size;
  width: min(100% - 2rem, var(--page-measure));
  margin-inline: auto;
  padding: clamp(1.2rem, 2.6vw, 2.6rem) clamp(1rem, 2.5vw, 2rem) 6rem;
  background: linear-gradient(180deg, rgb(255 255 255 / 0.99), #fff 34rem, #fbfcfb 100%);
  border-inline: 1px solid rgb(217 227 222 / 0.66);
  box-shadow: none;
}
.guide-reader > main {
  container: none;
  width: auto;
  margin: 0;
  padding: 0;
  background: none;
  border: 0;
}
main
  > :where(
    p,
    ul,
    ol,
    blockquote,
    details,
    address,
    .section-answer,
    .micro-answer,
    .answer-projection,
    .semantic-alias
  ),
.medical-guide
  > :where(
    p,
    ul,
    ol,
    blockquote,
    details,
    address,
    .section-answer,
    .micro-answer,
    .answer-projection,
    .semantic-alias
  ),
.content-section
  > :where(
    p,
    ul,
    ol,
    blockquote,
    details,
    address,
    .section-answer,
    .micro-answer,
    .answer-projection,
    .semantic-alias
  ) {
  max-width: var(--reading-measure);
  margin-inline-start: 0;
  margin-inline-end: auto;
}
.content-section {
  content-visibility: visible;
  contain: none;
}
[data-topic-navigation] {
  max-width: var(--reading-measure);
  margin-block: 2rem;
  padding-block-start: 1rem;
  border-block-start: 1px solid currentColor;
}
[data-topic-navigation] ul {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1.5rem;
  padding-inline-start: 1.5rem;
}
h1,
h2,
h3,
h4,
h5,
h6 {
  scroll-margin-top: 1.5rem;
}
h2,
h3,
h4,
h5,
h6 {
  line-height: 1.45;
}
h1,
h2 {
  text-wrap: balance;
}
h1 {
  max-width: 24ch;
  margin-block: 0.2rem 1.5rem;
  font-size: clamp(2rem, 4vw, 3.5rem);
  line-height: 1.3;
}
[data-route-context] h1 {
  max-width: none;
  font-size: clamp(1.65rem, 3vw, 2.5rem);
}
h2 {
  position: relative;
  margin-top: 4.6rem;
  padding-top: 0.35rem;
  border-block-start: 0;
  font-size: clamp(1.6rem, 3vw, 2.4rem);
}
h2::before {
  content: "";
  display: block;
  width: 2.9rem;
  height: 0.24rem;
  margin-block-end: 0.78rem;
  border-radius: 999px;
  background: linear-gradient(90deg, var(--accent-strong), #55a58f);
}
h3 {
  margin-top: 3.2rem;
  font-size: clamp(1.3rem, 2.2vw, 1.75rem);
}
h4,
h5,
h6 {
  margin-top: 2.2rem;
}
p {
  margin-block: 1rem;
}
a {
  color: var(--accent-strong);
  text-decoration-color: rgb(10 107 88 / 0.5);
  text-decoration-thickness: 0.08em;
  text-underline-offset: 0.2em;
}
a:hover {
  color: var(--accent);
  text-decoration-color: currentColor;
}
a[href^="tel:"] {
  direction: ltr;
  unicode-bidi: isolate;
  white-space: nowrap;
}
img,
video {
  display: block;
  max-width: 100%;
  height: auto;
}
video {
  width: auto;
  max-height: 75svh;
  margin-inline: auto;
}
/* Reserve each authored media ratio before its poster or metadata arrives. */
video[width="540"][height="960"] {
  aspect-ratio: 540 / 960;
  width: min(100%, calc(var(--video-max-height, 75svh) * 540 / 960));
}
video[width="480"][height="854"] {
  aspect-ratio: 480 / 854;
  width: min(100%, calc(var(--video-max-height, 75svh) * 480 / 854));
}
figure {
  content-visibility: visible;
  contain: none;
  margin: 2.2rem 0;
  padding: clamp(0.65rem, 1.5vw, 1rem);
  border: 1px solid transparent;
  background: none;
}
.hero-figure {
  contain-intrinsic-size: none;
}
figcaption {
  margin-top: 0.75rem;
  color: var(--muted);
  font-size: 0.925rem;
}
.section-answer {
  margin-block: 1.35rem 1.7rem;
  padding: 1rem 1.15rem;
  border: 1px solid #d4e6df;
  border-inline-start: 0.28rem solid var(--accent);
  box-shadow: 0 10px 30px rgb(17 53 42 / 0.045);
  border-radius: 0.8rem;
  background: linear-gradient(135deg, #f7fbf9, #edf7f3);
}
.answer-projection {
  margin-block: 1.15rem 1.45rem;
  padding: 0.9rem 1.05rem;
  border-inline-start: 0.24rem solid var(--accent-strong);
  border-radius: 0.65rem;
  background: var(--accent-soft);
  box-shadow: 0 10px 30px rgb(17 53 42 / 0.045);
}
.micro-answer,
.semantic-alias {
  padding: 0.75rem 0.9rem;
  border: 1px solid var(--line);
  border-radius: 0.7rem;
  background: var(--surface-soft);
}
.semantic-alias {
  color: #36443f;
  font-size: 0.96rem;
}
blockquote {
  margin: 1.5rem 0;
  padding: 0.9rem 1.1rem;
  border-inline-start: 0.25rem solid var(--accent);
  border-radius: 0.4rem;
  background: var(--surface-soft);
}
.skip-link {
  position: fixed;
  inset-inline-start: 1rem;
  top: -5rem;
  z-index: 1200;
  padding: 0.65rem 0.85rem;
  border: 1px solid var(--ink);
  border-radius: 0.6rem;
  background: #fff;
  box-shadow: 0 8px 24px rgb(0 0 0/0.12);
}
.skip-link:focus {
  top: 1rem;
}
.render-chunk {
  content-visibility: visible;
  contain: none;
  /* Admit the 4px high-contrast focus ring plus its 3px offset. */
  overflow-clip-margin: 8px;
}
.entity-hero {
  display: grid;
  grid-template-columns: minmax(0, 1.08fr) minmax(18rem, 0.92fr);
  grid-template-areas: "title portrait" "trust portrait" "subtitle portrait" "search portrait" "actions portrait" "lead lead" "identity identity";
  column-gap: clamp(1.3rem, 3vw, 3rem);
  row-gap: 0.56rem;
  align-items: start;
  margin-block-end: clamp(3rem, 6vw, 5rem);
  content-visibility: visible;
}
/* Paint the dependent hero blocks once the final portrait caption has parsed.
   The complete static page and cloned reader context expose all content without JS. */
.medical-guide--entity-home > .entity-hero:not(:has(> .hero-figure #medical-review-note)) > :not(.hero-title) {
  visibility: hidden;
}
.entity-hero .hero-title {
  grid-area: title;
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
  justify-self: center;
  margin-block-end: 0.05rem;
  text-align: center;
}
.guide-context .hero-title {
  max-width: 24ch;
  margin-block-start: 0.2rem;
  padding-block-start: 0;
  font-size: clamp(2rem, 4vw, 3.5rem);
  line-height: 1.3;
}
.guide-context .hero-title::before {
  display: none;
}
.hero-title__descriptor {
  order: -1;
  align-self: center;
  padding: 0.27rem 0.7rem;
  border: 0;
  border-radius: 999px;
  background: var(--accent-soft);
  color: #31584e;
  font-size: clamp(0.76rem, 0.36em, 0.9rem);
  font-weight: 720;
}
.hero-title__semantic-separator {
  display: none;
}
.hero-title__name {
  color: #14231e;
  font-size: clamp(2.05rem, 1.05em, 3rem);
  font-weight: 860;
  letter-spacing: -0.025em;
  line-height: 1.08;
}
.hero-title__name::after {
  content: "";
}
.entity-hero .hero-subtitle {
  grid-area: subtitle;
  justify-self: center;
  max-width: 34ch;
  margin: 0.05rem auto 0.3rem;
  color: #53635d;
  font-size: 1.04em;
  font-weight: 570;
  line-height: 1.55;
  text-align: center;
  text-wrap: balance;
}
.hero-subtitle__stop {
  color: #8f3934;
  font-weight: 820;
  white-space: nowrap;
}
.entity-hero .hero-lead {
  grid-area: lead;
}
.entity-hero .hero-identity {
  grid-area: identity;
}
.entity-hero .hero-actions {
  grid-area: actions;
}
.entity-hero .hero-figure {
  grid-area: portrait;
  align-self: start;
  margin: 0;
  padding: 0;
  position: relative;
  overflow: visible;
  border: 0;
  border-radius: 1.35rem;
  background: transparent;
  box-shadow: none;
}
.entity-hero .hero-figure img {
  width: 100%;
  aspect-ratio: 640/427;
  object-fit: cover;
  border-radius: 0;
}
.hero-portrait-media {
  position: relative;
}
.entity-hero .hero-portrait-media picture {
  display: block;
  overflow: hidden;
  border-radius: 1.35rem;
  background: #edf3f0;
  box-shadow: 0 24px 62px rgb(17 53 42 / 0.13);
}
.entity-hero .hero-figure figcaption {
  margin: 0;
  padding: 1.65rem 0.2rem 0.1rem;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
  direction: rtl;
  text-align: right;
}
.hero-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 0.58rem;
  margin: 0.82rem 0 1.15rem;
}
.hero-action {
  display: inline-flex;
  gap: 0.55rem;
  align-items: center;
  justify-content: center;
  min-width: 0;
  min-height: 3.25rem;
  padding: 0.72rem 0.8rem;
  border: 1px solid #d1e1db;
  border-radius: 0.92rem;
  background: rgb(255 255 255 / 0.92);
  color: #1d5b4b;
  font: inherit;
  font-weight: 780;
  line-height: 1.35;
  text-align: center;
  text-decoration: none;
  box-shadow: none;
  cursor: pointer;
  transition: transform 150ms ease, border-color 150ms ease, box-shadow 150ms ease, background-color 150ms ease;
}
.hero-action--portfolio,
.hero-action--location {
  position: relative;
  overflow: hidden;
  background: linear-gradient(145deg, #fff, #f8fbf9);
}
.hero-action--portfolio::before,
.hero-action--location::before {
  content: "";
  width: 0.52rem;
  height: 0.52rem;
  flex: 0 0 auto;
  border-radius: 999px;
}
.hero-action--portfolio::before {
  background: #a77822;
  box-shadow: 0 0 0 0.28rem rgb(167 120 34 / 0.1);
}
.hero-action--location::before {
  background: #0a6b58;
  box-shadow: 0 0 0 0.28rem rgb(10 107 88 / 0.1);
}
.hero-action--primary {
  grid-column: 1 / -1;
  min-height: 3.85rem;
  border-color: #064d40;
  border-radius: 1rem;
  background: radial-gradient(circle at 12% 0%, rgb(255 255 255 / 0.16), transparent 34%), linear-gradient(135deg, #064d40, #0a6b58 62%, #0d7560);
  color: #fff;
  font-size: clamp(1rem, 0.96rem + 0.18vw, 1.08rem);
  font-weight: 850;
  box-shadow: 0 15px 30px rgb(6 77 64 / 0.18), 0 1px 0 rgb(255 255 255 / 0.14) inset;
}
.quick-actions {
  position: fixed;
  z-index: 1000;
  left: 50%;
  bottom: max(0.7rem, calc(env(safe-area-inset-bottom) + 0.3rem));
  width: min(calc(100% - 1rem), 33rem);
  margin: 0;
  transform: translateX(-50%);
  pointer-events: none;
  content-visibility: visible;
}
.quick-actions__bar {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  align-items: center;
  min-height: 3.58rem;
  padding: 0.3rem;
  border: 1px solid rgb(255 255 255 / 0.76);
  border-radius: 999px;
  background: rgb(250 252 251 / 0.88);
  box-shadow: 0 16px 44px rgb(17 39 31 / 0.16), 0 1px 0 rgb(255 255 255 / 0.96) inset;
  backdrop-filter: blur(18px) saturate(150%);
  -webkit-backdrop-filter: blur(18px) saturate(150%);
  pointer-events: auto;
}
.quick-actions__item {
  position: relative;
  display: inline-flex;
  gap: 0.4rem;
  align-items: center;
  justify-content: center;
  min-width: 0;
  min-height: 2.92rem;
  padding: 0.34rem 0.48rem;
  border-radius: 999px;
  background: transparent;
  color: #2f4b43;
  font-size: clamp(0.74rem, 0.7rem + 0.14vw, 0.82rem);
  font-weight: 760;
  line-height: 1;
  text-align: center;
  text-decoration: none;
  white-space: nowrap;
  -webkit-tap-highlight-color: transparent;
}
.quick-actions__item + .quick-actions__item::before {
  content: "";
  position: absolute;
  inset-block: 25%;
  inset-inline-start: 0;
  width: 1px;
  background: rgb(24 33 30/0.1);
}
.quick-actions__item--consultation {
  gap: 0.5rem;
  background: linear-gradient(135deg, #075244, #0a6b58);
  color: #fff;
  box-shadow: 0 8px 20px rgb(7 82 68 / 0.2);
}
.quick-actions__item--consultation:hover,
.quick-actions__item--consultation:focus-visible {
  background: #064d40;
  color: #fff;
}
.quick-actions__consultation-copy {
  display: grid;
  gap: 0.1rem;
  min-width: 0;
  text-align: center;
  line-height: 1.05;
}
.quick-actions__consultation-copy strong {
  font-size: 1em;
  font-weight: 790;
}
.quick-actions__item svg,
.quick-actions__top svg {
  width: 1.08rem;
  height: 1.08rem;
  flex: 0 0 auto;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
}
.quick-actions__top {
  position: absolute;
  left: 50%;
  bottom: calc(100% + 0.42rem);
  display: grid;
  place-items: center;
  width: 2.15rem;
  height: 2.15rem;
  border: 1px solid rgb(24 33 30/0.08);
  border-radius: 999px;
  background: #fff;
  color: #315148;
  box-shadow: 0 6px 18px rgb(17 39 31/0.1);
  opacity: 0;
  visibility: hidden;
  transform: translateX(-50%) translateY(0.45rem) scale(0.96);
  text-decoration: none;
  pointer-events: none;
  transition:
    opacity 160ms ease,
    visibility 160ms ease,
    background-color 140ms ease,
    color 140ms ease,
    transform 160ms ease;
}
.quick-actions__top[data-visible="true"] {
  opacity: 1;
  visibility: visible;
  transform: translateX(-50%) translateY(0) scale(1);
  pointer-events: auto;
}
.quick-actions__top::before {
  content: "";
  position: absolute;
  inset: -0.35rem;
  border-radius: inherit;
}
@media (max-width: 720px) {
  html {
    scroll-behavior: auto;
  }
  main,
  .guide-reader {
    width: min(100% - 0.7rem, var(--page-measure));
    padding: 1rem 0.68rem calc(7.2rem + env(safe-area-inset-bottom));
    border-inline: 0;
    border-radius: 0;
    box-shadow: none;
  }
  h1,
  .guide-context .hero-title {
    font-size: clamp(1.85rem, 8.3vw, 2.65rem);
  }
}
@media (max-width: 960px) {
  .entity-hero {
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: "title" "trust" "subtitle" "search" "portrait" "actions" "lead" "identity";
    gap: 0.5rem;
    margin-block-end: 2.2rem;
  }
  .entity-hero .hero-title {
    gap: 0.32rem;
    margin-block-end: 0;
  }
  .entity-hero .hero-subtitle {
    margin-block: 0 0.2rem;
  }
  .entity-hero .hero-figure {
    width: min(100%, 32rem);
    justify-self: center;
    border-radius: 1.2rem;
  }
  .entity-hero .hero-portrait-media picture {
    border-radius: 1.2rem;
  }
  .entity-hero .hero-lead,
  .entity-hero .hero-identity {
    margin-block: 0.55rem;
  }
}
@media (max-width: 48rem) {
  :root {
    font-family:
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      Tahoma,
      Arial,
      sans-serif;
  }
}
@media (max-width: 480px) {
  .quick-actions {
    left: max(0.45rem, env(safe-area-inset-left));
    right: max(0.45rem, env(safe-area-inset-right));
    width: auto;
    transform: none;
  }
  .quick-actions__bar {
    min-height: 3.35rem;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr) minmax(0, 1fr);
    padding: 0.24rem 0.26rem;
  }
  .quick-actions__item {
    gap: 0.27rem;
    min-height: 2.75rem;
    padding: 0.3rem 0.26rem;
    font-size: clamp(0.7rem, 2.9vw, 0.76rem);
  }
  .quick-actions__item--consultation {
    gap: 0.34rem;
  }
  .quick-actions__item svg {
    width: 1rem;
    height: 1rem;
  }
}
.quick-actions__item--consultation svg {
  width: 1.12rem;
  height: 1.12rem;
}
@media print {
  .quick-actions {
    display: none !important;
  }
}

.hero-search-launch {
  grid-area: search;
  display: inline-flex;
  gap: 0.45rem;
  align-items: center;
  justify-self: center;
  width: fit-content;
  min-height: 2.75rem;
  margin: 0 auto 0.35rem;
  padding: 0.45rem 0.65rem;
  border: 1px solid #d3e0db;
  border-radius: 0.75rem;
  background: #fff;
  color: var(--accent-strong);
  font: inherit;
  font-weight: 740;
  line-height: 1.35;
  cursor: pointer;
}
.hero-search-launch svg {
  width: 1rem;
  height: 1rem;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.7;
  stroke-linecap: round;
  stroke-linejoin: round;
}
.hero-search-launch kbd {
  padding: 0.05rem 0.22rem;
  border: 0;
  background: none;
  color: #687671;
  font:
    600 0.66rem/1 ui-monospace,
    SFMono-Regular,
    Menlo,
    monospace;
}
.hero-figure-caption,
.clinical-figure-caption {
  display: grid;
  gap: 0.4rem;
}
.hero-caption-title,
.figure-caption-title {
  color: #263b35;
  font-weight: 780;
}
.hero-caption-title {
  display: block;
  width: 100%;
  margin: 0;
  color: #1d352e;
  font-size: clamp(1rem, 0.94rem + 0.3vw, 1.18rem);
  font-weight: 820;
  line-height: 1.45;
  text-align: start;
}
.caption-disclosure {
  overflow: visible;
  margin: 0;
  padding: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
}
.caption-disclosure[open] {
  background: transparent;
}
.caption-disclosure > summary {
  display: block;
  width: fit-content;
  max-width: 100%;
  list-style: none;
  cursor: pointer;
}
.caption-disclosure > summary::-webkit-details-marker {
  display: none;
}
.caption-disclosure > summary::marker {
  content: "";
}
.caption-disclosure > summary:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 0.25rem;
  border-radius: 0.2rem;
}
.caption-disclosure > :not(summary) {
  margin-block-start: 0.35rem;
}
.hero-trust-strip strong {
  color: #36584e;
  font-weight: 760;
}
.hero-rating-seal {
  position: absolute;
  z-index: 6;
  top: 0.82rem;
  right: auto;
  bottom: auto;
  left: 0.82rem;
  display: inline-flex;
  flex-direction: column;
  gap: 0.22rem;
  align-items: center;
  justify-content: center;
  width: clamp(6.15rem, 20vw, 7.15rem);
  aspect-ratio: 1;
  padding: 0.72rem;
  border: 2px solid rgb(170 116 24 / 0.82);
  border-radius: 50%;
  background:
    radial-gradient(circle at 42% 34%, rgb(255 255 255 / 0.34), rgb(255 255 255 / 0.08) 55%, transparent 76%);
  color: #173f35;
  box-shadow:
    0 0 0 1px rgb(255 255 255 / 0.46) inset,
    0 0 0 0.22rem rgb(170 116 24 / 0.12);
  filter: drop-shadow(0 5px 8px rgb(17 53 42 / 0.22));
  line-height: 1;
  text-align: center;
  text-decoration: none;
  transform: rotate(-7deg);
  isolation: isolate;
  transition:
    transform 160ms ease,
    filter 160ms ease,
    border-color 160ms ease;
}
.hero-rating-seal::before {
  content: "";
  position: absolute;
  z-index: -1;
  inset: 0.32rem;
  border: 1.5px dashed rgb(170 116 24 / 0.72);
  border-radius: 50%;
  pointer-events: none;
}
.hero-rating-seal::after {
  content: "";
  position: absolute;
  z-index: -1;
  inset: 0.62rem;
  border: 1px solid rgb(23 63 53 / 0.2);
  border-radius: 50%;
  pointer-events: none;
}
.hero-rating-seal:hover,
.hero-rating-seal:focus-visible {
  color: #173f35;
  border-color: rgb(170 116 24 / 0.96);
  filter: drop-shadow(0 7px 11px rgb(17 53 42 / 0.28));
  transform: rotate(-7deg) translateY(-2px) scale(1.035);
}
.hero-rating-seal:focus-visible {
  outline: 3px solid var(--accent);
  outline-offset: 0.28rem;
}
.hero-rating-seal__title {
  position: relative;
  z-index: 1;
  margin: 0;
  color: #173f35;
  font-family: Arial, sans-serif;
  font-size: clamp(0.7rem, 2.3vw, 0.86rem);
  font-weight: 900;
  letter-spacing: 0.14em;
  line-height: 1;
  text-transform: uppercase;
  white-space: nowrap;
}
.hero-rating-seal__stars {
  position: relative;
  z-index: 1;
  margin: 0;
  color: #b27813;
  font-size: clamp(0.9rem, 2.9vw, 1.08rem);
  font-weight: 800;
  letter-spacing: 0.08em;
  line-height: 1;
  text-shadow:
    0 1px 0 rgb(255 255 255 / 0.82),
    0 2px 5px rgb(120 78 10 / 0.18);
  white-space: nowrap;
}
.hero-trust-strip {
  grid-area: trust;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 0;
  justify-self: center;
  width: 100%;
  margin: 0.3rem auto 0.2rem;
  padding: 0.42rem 0;
  border: 0;
  border-block: 1px solid #dce7e2;
  border-radius: 0;
  background: transparent;
