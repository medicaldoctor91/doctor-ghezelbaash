#guide-search.guide-search {
  z-index: 30;
  width: min(100%,34rem);
  max-height: none;
  box-shadow: none;
  background: 0 0;
  border: 0;
  border-radius: 0;
  grid-area: search;
  justify-self: center;
  margin: 0 auto .35rem;
  padding: 0;
  position: relative;
}
#guide-search.guide-search:not([data-mounted]) {
  display: none;
}
#guide-search .guide-search__field {
  background: #fff;
  border: 1px solid #c7d8d2;
  border-radius: 999px;
  grid-template-columns: auto minmax(0,1fr) auto;
  align-items: center;
  gap: .55rem;
  min-height: 2.75rem;
  padding-inline: .82rem .65rem;
  font-weight: 700;
  display: grid;
}
#guide-search .guide-search__field:focus-within {
  border-color: var(--accent-strong);
  outline: 2px solid var(--accent-strong);
  outline-offset: 2px;
}
#guide-search .guide-search__field svg {
  fill: none;
  width: 1.05rem;
  height: 1.05rem;
  stroke: var(--accent-strong);
  stroke-width: 1.8px;
  stroke-linecap: round;
  stroke-linejoin: round;
}
#guide-search .guide-search__field input {
  width: 100%;
  min-width: 0;
  min-height: 2.65rem;
  color: var(--ink);
  font: inherit;
  background: 0 0;
  border: 0;
  outline: 0;
  padding: 0;
  font-weight: 650;
}
#guide-search .guide-search__field input::placeholder {
  color: #687671;
  opacity: 1;
}
#guide-search .guide-search__field kbd {
  color: #52615a;
  background: 0 0;
  border: 0;
  padding: .05rem .2rem;
  font: 600 .68rem/1 ui-monospace,SFMono-Regular,Menlo,monospace;
}
#guide-search .guide-search__status {
  clip: rect(0 0 0 0);
  white-space: nowrap;
  width: 1px;
  height: 1px;
  margin: -1px;
  position: absolute;
  overflow: hidden;
}
#guide-search .guide-search__results {
  z-index: 40;
  inset-inline: 0;
  overscroll-behavior: contain;
  background: #fff;
  border: 1px solid #d4e0dc;
  border-radius: .8rem;
  gap: .25rem;
  max-height: min(46vh,25rem);
  margin: 0;
  padding: .35rem;
  list-style: none;
  display: grid;
  position: absolute;
  top: calc(100% + .4rem);
  overflow: auto;
  box-shadow: 0 16px 42px #11271f24;
}
#guide-search .guide-search__results[hidden] {
  display: none;
}
#guide-search .guide-search__results a {
  color: var(--ink);
  outline-offset: -3px;
  background: 0 0;
  border: 0;
  border-radius: .55rem;
  gap: .1rem;
  padding: .58rem .68rem;
  text-decoration: none;
  display: grid;
}
#guide-search .guide-search__results a:hover,#guide-search .guide-search__results a:focus-visible {
  background: var(--accent-soft);
}
#guide-search .guide-search__result-title {
  font-weight: 780;
  line-height: 1.5;
}
#guide-search .guide-search__result-context {
  color: var(--muted);
  font-size: .78rem;
  line-height: 1.4;
}
#guide-search .guide-search__empty {
  color: var(--muted);
  padding: .68rem;
  font-size: .9rem;
}
@media (width<=720px) {
  #guide-search.guide-search {
    width: 100%;
    margin: 0 0 .25rem;
  }
  #guide-search .guide-search__field {
    min-height: 2.95rem;
    box-shadow: none;
    border-radius: .82rem;
  }
  #guide-search .guide-search__field kbd {
    display: none;
  }
  #guide-search .guide-search__results {
    max-height: 48dvh;
  }
}
@media (prefers-contrast:more) {
  #guide-search .guide-search__field {
    border-width: 2px;
  }
}
@media (forced-colors:active) {
  #guide-search .guide-search__field,#guide-search .guide-search__results {
    box-shadow: none;
    border: 1px solid canvastext;
  }
  #guide-search .guide-search__field:focus-within {
    outline-offset: 2px;
    outline: 2px solid highlight;
  }
}


