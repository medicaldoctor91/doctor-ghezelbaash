---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Content, frontmatter } from '../../.generated/content/home.md';

const pageFrontmatter = frontmatter as {
  title: string;
  description: string;
  lang: string;
  dir: string;
  robots: string;
  socialImageAlt: string;
  socialAlternateLocales: string[];
  footerGovernance: {
    summary: string;
    medicalNotice: string;
    reputationLead: string;
    mapsTerms: { href: string; label: string };
    privacyPolicy: { href: string; label: string };
    tail: string;
  };
};
---

<BaseLayout frontmatter={pageFrontmatter} isMain={true}>
  <Content />
</BaseLayout>
