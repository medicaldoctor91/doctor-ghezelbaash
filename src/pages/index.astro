---
import BaseLayout from '../layouts/BaseLayout.astro';
import { pageBody, pageFrontmatter } from '../lib/canonical-inputs.mjs';
import { renderCanonicalPageHtml } from '../lib/canonical-page-html.mjs';

// The comprehensive home remains the shared single-page reader. Focused direct
// entry documents are derived from this rendered content after the Astro build.
const html = renderCanonicalPageHtml(pageBody);
---

<BaseLayout frontmatter={pageFrontmatter} isMain={true}>
  <Fragment set:html={html} />
</BaseLayout>
