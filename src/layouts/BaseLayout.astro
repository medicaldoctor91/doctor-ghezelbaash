---
import { createHash } from 'node:crypto';
import globalCss from '../styles/global.css?raw';
import criticalMobileCss from '../styles/critical-mobile.css?raw';
import { headGraphRaw, supportGraphRaw } from '../lib/knowledge-graph';
import DocumentHead from '../components/DocumentHead.astro';
import SiteFooter from '../components/SiteFooter.astro';
import FloatingActionDock from '../components/FloatingActionDock.astro';
import GuideNavigator from '../components/GuideNavigator.astro';
interface Frontmatter { title:string; description:string; lang?:string; dir?:'ltr'|'rtl'|'auto'; robots?:string; }
interface Props { frontmatter:Frontmatter; url?:string; isMain?:boolean; }
type JsonNode=Record<string,any>;
const {frontmatter,url,isMain=false}=Astro.props;const base=Astro.site??Astro.url;const canonicalURL=new URL(url??Astro.url.pathname,base);
const lang=frontmatter.lang??'fa-IR';const dir=frontmatter.dir??'rtl';const robots=frontmatter.robots??'index, follow';const noindex=/(?:^|,)\s*noindex\b/i.test(robots);
const cssSplitMarker='/*DIST_CRITICAL_CSS_END*/';const cssSplitAt=globalCss.indexOf(cssSplitMarker);if(cssSplitAt<0)throw new Error('Critical CSS split marker missing');const cssExternalAt=cssSplitAt+cssSplitMarker.length;const criticalCss=globalCss.slice(0,cssExternalAt)+criticalMobileCss;const externalCss=globalCss.slice(cssExternalAt);const externalCssHash=createHash('sha256').update(externalCss).digest('hex').slice(0,12);const externalCssHref=`/assets/site.${externalCssHash}.css`;
const googleSupportGraphRaw=supportGraphRaw;

---
<!doctype html><html lang={lang} dir={dir} prefix="og: https://ogp.me/ns# profile: https://ogp.me/ns/profile#"><head><meta charset="utf-8" /><DocumentHead title={frontmatter.title} description={frontmatter.description} robots={robots} canonicalURL={canonicalURL} isMain={isMain} />{isMain&&<script is:inline id="entity-core" type="application/ld+json" set:html={headGraphRaw}></script>}<style is:inline set:html={criticalCss}></style><link as="style" data-deferred-stylesheet href={externalCssHref} rel="preload" /><script is:inline id="deferred-stylesheet-loader">(()=>{const l=document.querySelector('link[data-deferred-stylesheet]');if(!l)return;const a=()=>{l.rel='stylesheet';l.removeAttribute('as')};l.addEventListener('load',a,{once:true})})();</script><noscript><link href={externalCssHref} rel="stylesheet" /></noscript></head><body><a class="skip-link" href="#main-content">پرش به محتوای اصلی</a><main id="main-content"><slot /></main>{isMain&&<script is:inline id="entity-support" type="application/ld+json" set:html={googleSupportGraphRaw}></script>}{!noindex&&<SiteFooter />}{!noindex&&<FloatingActionDock />}{isMain&&<GuideNavigator />}</body></html>