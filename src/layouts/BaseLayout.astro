---
import '../styles/global.css';
import headGraph from '../data/semantic/head-graph.min.jsonld?raw';

const { frontmatter, url } = Astro.props;
const baseURL = Astro.site ?? Astro.url;
const canonicalURL = new URL(url ?? Astro.url.pathname, baseURL);
const ogImageURL = new URL('/media/images/physician/saeed-ghezelbash-portrait-1600.webp', baseURL);

const title = frontmatter.title;
const description = frontmatter.description;
const lang = frontmatter.lang ?? 'fa-IR';
const dir = frontmatter.dir ?? 'rtl';
const robots = frontmatter.robots ?? 'index, follow';
---
<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="author" content="دکتر سعید قزلباش" />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fa_IR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="وب‌سایت رسمی دکتر سعید قزلباش" />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1600" />
    <meta property="og:image:height" content="1068" />
    <meta property="og:image:alt" content="پرتره رسمی دکتر سعید قزلباش، پزشک زیبایی در کرمانشاه" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <script type="application/ld+json" set:html={headGraph}></script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">پرش به محتوای اصلی</a>
    <main id="main-content">
      <slot />
    </main>
  </body>
</html>
