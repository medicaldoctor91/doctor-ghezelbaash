---
import globalCss from '../styles/global.css?raw';
import renderCalibrationRaw from '../data/render-calibration.json?raw';
import release from '../data/release.json';
import { headGraph, headGraphRaw, supportGraphRaw } from '../lib/knowledge-graph';
import { deriveGooglePageMicrodata } from '../lib/google-page-microdata.mjs';
import { assembleCssSource, deriveCssDelivery } from '../lib/css-delivery.mjs';
import DocumentHead from '../components/DocumentHead.astro';
import SiteFooter from '../components/SiteFooter.astro';
import FloatingActionDock from '../components/FloatingActionDock.astro';
import GuideNavigator from '../components/GuideNavigator.astro';

interface Frontmatter {
  title: string;
  description: string;
  lang: string;
  dir: string;
  robots: string;
  socialImageAlt?: string;
  socialAlternateLocales?: string[];
  footerGovernance?: {
    summary: string;
    reputationLead: string;
    mapsTerms: { href: string; label: string };
    privacyPolicy: { href: string; label: string };
    tail: string;
  };
}

interface Props {
  frontmatter: Frontmatter;
  isMain: boolean;
}

const { frontmatter, isMain } = Astro.props;
const { lang, dir, robots } = frontmatter;
if (!lang || !robots) {
  throw new Error('Document frontmatter requires lang and robots');
}
if (!['ltr', 'rtl', 'auto'].includes(dir)) {
  throw new Error(`Invalid document direction: ${dir}`);
}
const noindex = /(?:^|,)\s*noindex\b/i.test(robots);
const footerGovernance = frontmatter.footerGovernance;
if (!noindex && !footerGovernance) {
  throw new Error('Indexable document frontmatter requires footer governance');
}
if (!Astro.site) {
  throw new Error('Astro site URL is required for canonical resolution');
}
const canonicalURL = isMain
  ? new URL(release.canonicalUrl)
  : noindex
    ? undefined
    : new URL(Astro.url.pathname, Astro.site);
const entityHeadingId = isMain
  ? new URL(release.primaryEntity.id, release.canonicalUrl).hash.slice(1)
  : undefined;
if (isMain && !entityHeadingId) {
  throw new Error('Primary entity pointer must expose a same-page fragment identifier');
}

const { cssSource } = assembleCssSource(globalCss, renderCalibrationRaw);
const { criticalCss, assetHref: externalCssHref } = deriveCssDelivery(cssSource);
const googlePageMicrodata = isMain
  ? deriveGooglePageMicrodata(headGraph, `${release.canonicalUrl}#webpage`)
  : null;
---

<!doctype html>
<html lang={lang} dir={dir} prefix="og: https://ogp.me/ns# profile: https://ogp.me/ns/profile#">
  <head>
    <meta charset="utf-8">
    <DocumentHead
      title={frontmatter.title}
      description={frontmatter.description}
      lang={lang}
      robots={robots}
      socialImageAlt={frontmatter.socialImageAlt}
      socialAlternateLocales={frontmatter.socialAlternateLocales}
      canonicalURL={canonicalURL}
      isMain={isMain}
    >
      <style is:inline set:html={criticalCss}></style>
      <link
        as="style"
        data-deferred-stylesheet
        fetchpriority="low"
        href={externalCssHref}
        rel="preload"
      >
      <script is:inline id="deferred-stylesheet-loader">
        (() => {
          const link = document.querySelector('link[data-deferred-stylesheet]');
          if (!link) return;

          let activated = false;
          const activate = () => {
            if (activated) return;
            activated = true;
            link.rel = 'stylesheet';
            link.removeAttribute('as');
          };

          link.addEventListener('load', activate, { once: true });
          link.addEventListener('error', activate, { once: true });
          if (link.sheet) activate();
          else setTimeout(activate, 2500);
        })();
      </script>
      <noscript><link href={externalCssHref} rel="stylesheet"></noscript>
    </DocumentHead>
  </head>
  <body>
    <a class="skip-link" href="#main-content">پرش به محتوای اصلی</a>
    <main
      id="main-content"
      tabindex="-1"
      itemscope={googlePageMicrodata ? true : undefined}
      itemtype={googlePageMicrodata?.itemType}
      itemid={googlePageMicrodata?.itemId}
    >
      {googlePageMicrodata && (
        <>
          {googlePageMicrodata.links.map((link) => (
            <link itemprop={link.itemprop} href={link.href}>
          ))}
          {googlePageMicrodata.meta.map((meta) => (
            <meta itemprop={meta.itemprop} content={meta.content}>
          ))}
        </>
      )}
      <article
        class:list={['medical-guide', { 'medical-guide--entity-home': isMain }]}
        aria-labelledby={entityHeadingId}
      >
        <slot />
      </article>
    </main>
    {isMain && (
      <>
        <script
          is:inline
          id="entity-core"
          type="application/ld+json"
          set:html={headGraphRaw}
        ></script>
        <script
          is:inline
          id="entity-support"
          type="application/ld+json"
          set:html={supportGraphRaw}
        ></script>
      </>
    )}
    {!noindex && footerGovernance && <SiteFooter governance={footerGovernance} />}
    {!noindex && <FloatingActionDock />}
    {isMain && <GuideNavigator />}
  </body>
</html>
