---
import { canonicalLifecycle as release, canonicalGraph } from '../lib/canonical-inputs.mjs';
import { footerLabels as labels } from '../config/site-policy.mjs';
import { indexCanonicalGraph, nodeTypes } from '../lib/graph-core.mjs';
import { FOOTER_RESOURCES } from '../lib/resources.mjs';

const { byId } = indexCanonicalGraph(canonicalGraph);
const dataset = byId.get(release.dataset.id);
if (
  !dataset ||
  !nodeTypes(dataset).includes('Dataset') ||
  typeof dataset.name !== 'string' ||
  typeof dataset.description !== 'string' ||
  dataset.description.trim().length < 50
) {
  throw new Error('Site footer requires the canonical Dataset name and description');
}
const datasetDisclosure = {
  name: dataset.name,
  description: dataset.description,
};
const footerLinks = FOOTER_RESOURCES.map((resource, index) => ({
  path: resource.path,
  label: resource.footerLabel,
  rel: resource.headRel,
  type: resource.contentType,
  separator: index === FOOTER_RESOURCES.length - 1 ? '' : ' · ',
}));
const kaggleResources = [
  { id: 'https://www.ghezelbaash.ir/project-kaggle-dataset', label: labels.kaggleDataset },
  { id: 'https://www.ghezelbaash.ir/project-kaggle-notebook', label: labels.kaggleNotebook },
].map(({ id, label }) => {
  const resource = byId.get(id);
  if (!resource || typeof resource.url !== 'string' || !resource.url.startsWith('https://www.kaggle.com/')) {
    throw new Error(`Site footer requires canonical Kaggle resource URL: ${id}`);
  }
  return { href: resource.url, label };
});
---

<footer aria-label={labels.machineResourcesAriaLabel} class="site-footer">
  <details class="footer-machine-resources">
    <summary>{labels.machineResourcesSummary}</summary>
    <p class="footer-dataset-disclosure">
      <strong>{datasetDisclosure.name}</strong> — {datasetDisclosure.description}
    </p>
    <nav aria-label={labels.machineResourcesAriaLabel}>
      {
        footerLinks.map((link) => (
          <Fragment>
            <a href={`/${link.path}`} rel={link.rel} type={link.type}>{link.label}</a>
            {link.separator}
          </Fragment>
        ))
      }
    </nav>
    <nav aria-label={labels.kaggleAriaLabel}>
      {
        kaggleResources.map((link, index) => (
          <Fragment>
            <a href={link.href} rel="external noopener">{link.label}</a>
            {index === kaggleResources.length - 1 ? '' : ' · '}
          </Fragment>
        ))
      }
    </nav>
  </details>
</footer>
