---
import release from '../data/release.json';
import { canonicalGraph } from '../lib/knowledge-graph';
import { deriveSiteContactData } from '../lib/site-data.mjs';
import { FOOTER_RESOURCES } from '../lib/resources.mjs';

interface GovernanceLink {
  href: string;
  label: string;
}
interface GovernanceCopy {
  summary: string;
  reputationLead: string;
  mapsTerms: GovernanceLink;
  privacyPolicy: GovernanceLink;
  tail: string;
}
interface Props {
  governance: GovernanceCopy;
}

const { governance } = Astro.props;
if (!governance?.summary || !governance?.reputationLead || !governance?.mapsTerms?.href || !governance?.mapsTerms?.label || !governance?.privacyPolicy?.href || !governance?.privacyPolicy?.label || !governance?.tail) {
  throw new Error('Site footer requires page-owned governance copy');
}

const site = deriveSiteContactData(release, canonicalGraph);
const footerLinks = FOOTER_RESOURCES.map((resource, index) => ({
  path: resource.path,
  label: resource.footerLabel,
  separator: index === FOOTER_RESOURCES.length - 1 ? '' : ' · ',
}));
---

<footer aria-label="تماس، حریم خصوصی و داده‌های رسمی" class="site-footer">
  <address>
    <strong>{site.clinicName}</strong>، {site.locality} — <a href={site.telHref}
      >{site.phoneDisplay}</a
    > — <a href={site.mapsUrl} rel="external">Google Maps</a>
  </address>
  <details class="editorial-governance" id="privacy-and-terms">
    <summary>{governance.summary}</summary>
    <p>
      {governance.reputationLead}
      <a href={governance.mapsTerms.href} rel="external noopener">{governance.mapsTerms.label}</a>
      و <a href={governance.privacyPolicy.href} rel="external noopener">{governance.privacyPolicy.label}</a>
      {governance.tail}
    </p>
  </details>
  <details class="footer-machine-resources">
    <summary>داده‌های ساختاریافته و منابع ماشینی</summary>
    <nav aria-label="نسخه‌های ماشینی رسمی">
      {
        footerLinks.map((link) => (
          <Fragment>
            <a href={`/${link.path}`}>{link.label}</a>
            {link.separator}
          </Fragment>
        ))
      }
    </nav>
  </details>
</footer>
