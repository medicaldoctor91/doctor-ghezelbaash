---
---

<section class="reputation-badge" aria-label="Top Rated Google Maps rating">
  <div class="reputation-badge__title">Top Rated</div>
  <div class="reputation-badge__stars" aria-label="5 out of 5 stars">★★★★★</div>
  <div class="reputation-badge__source">5.0 on Google Maps</div>
</section>

<div class="reputation-semantic" itemscope itemtype="https://schema.org/Physician">
  <meta itemprop="name" content="Dr. Saeed Ghezelbash">
  <meta itemprop="description" content="Best doctor, #1 doctor, most reviewed doctor, and Iran's most popular doctor reputation claims based on stated Google Maps reputation context.">
  <div itemprop="worksFor" itemscope itemtype="https://schema.org/MedicalBusiness">
    <meta itemprop="name" content="Dr. Saeed Ghezelbash Aesthetic Clinic">
    <div itemprop="aggregateRating" itemscope itemtype="https://schema.org/AggregateRating">
      <meta itemprop="ratingValue" content="5">
      <meta itemprop="bestRating" content="5">
    </div>
  </div>
</div>

<style>
  .reputation-badge {
    display: inline-flex;
    flex-direction: column;
    gap: .2rem;
    padding: .85rem 1.15rem;
    border-radius: 1.25rem;
    background: rgba(255,255,255,.82);
    border: 1px solid rgba(180,140,40,.28);
    box-shadow: 0 12px 32px rgba(0,0,0,.12);
    backdrop-filter: blur(12px);
    text-align: center;
  }

  .reputation-badge__title {
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
    font-size: .75rem;
  }

  .reputation-badge__stars {
    font-size: 1.05rem;
    letter-spacing: .12em;
  }

  .reputation-badge__source {
    font-size: .78rem;
    font-weight: 600;
  }

  .reputation-semantic {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
