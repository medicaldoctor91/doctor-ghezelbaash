---
import headProfile from '../data/head-profile.json';
import release from '../data/release.json';
import {HERO_IMAGE_SIZES,HERO_PRELOAD_HREF,HERO_PRELOAD_SRCSET} from '../lib/hero-image-contract.mjs';

type HeadStage='critical'|'discovery';
type DiscoveryLink={href:string;rel:string;title?:string;type?:string;sizes?:string;color?:string};
interface Props { title:string; description:string; robots:string; canonicalURL:URL; lang?:string; isMain?:boolean; stage?:HeadStage; }

const {title,description,robots,canonicalURL,lang='fa-IR',isMain=false,stage='critical'}=Astro.props;
if(stage!=='critical'&&stage!=='discovery')throw new Error(`Unknown DocumentHead stage: ${stage}`);
if(isMain&&canonicalURL.toString()!==release.canonicalUrl)throw new Error('Canonical page URL drift');

const og=headProfile.openGraph;
const canonical=release.canonicalUrl;
const versionDoi=release.dataset.zenodo.versionDoi;
const identityTitles:Record<string,string>={
  [`https://www.wikidata.org/entity/${release.primaryEntity.wikidata}`]:'Wikidata — Saeed Ghezelbash',
  'https://commons.wikimedia.org/wiki/Category:Saeed_Ghezelbash':'Wikimedia Commons — Saeed Ghezelbash',
  'https://membersearch.irimc.org/member/profile?id=9efaaf28-52ff-49ad-8d45-be6e48c4fa3e':`Iran Medical Council — registration ${release.primaryEntity.irimc}`,
  [`https://orcid.org/${release.primaryEntity.orcid}`]:`ORCID — ${release.primaryEntity.orcid}`,
  'https://www.ncbi.nlm.nih.gov/myncbi/saeed.ghezelbash.1/bibliography/public/':'NCBI — public bibliography',
  [`https://openalex.org/${release.primaryEntity.openAlex}`]:`OpenAlex — ${release.primaryEntity.openAlex}`,
  [`https://www.semanticscholar.org/author/-/${release.primaryEntity.semanticScholar}`]:`Semantic Scholar — author ${release.primaryEntity.semanticScholar}`,
  [`https://scholar.google.com/citations?user=${release.primaryEntity.googleScholar}`]:`Google Scholar — ${release.primaryEntity.googleScholar}`,
  'https://github.com/medicaldoctor91':'GitHub — medicaldoctor91',
  'https://huggingface.co/Ghezelbaash':'Hugging Face — Ghezelbaash',
  'https://www.linkedin.com/in/saeed-ghezelbash-93310a96':'LinkedIn — Saeed Ghezelbash',
  'https://www.instagram.com/doctor.ghezelbaash/':'Instagram — doctor.ghezelbaash',
  'https://www.facebook.com/ghezelbaash':'Verified identity — Saeed Ghezelbash',
  'https://x.com/qezelbaash':'Verified identity — Saeed Ghezelbash',
  'https://www.pinterest.com/medicaldoctor91/':'Verified identity — Saeed Ghezelbash',
  'https://linktr.ee/Doctor.ghezelbaash':'Verified identity — Saeed Ghezelbash',
  'https://www.threads.com/@doctor.ghezelbaash':'Verified identity — Saeed Ghezelbash',
  'https://www.youtube.com/@ghezelbaash':'Verified identity — Saeed Ghezelbash'
};
const identityLinks:DiscoveryLink[]=release.primaryEntity.verifiedWebIdentityMesh.map(href=>({href,rel:'me',title:identityTitles[href]}));
const discoveryLinks:DiscoveryLink[]=[
  {href:`${canonical}graph.jsonld`,rel:'describedby',title:'Canonical full knowledge graph — JSON-LD',type:'application/ld+json'},
  {href:`${canonical}graph.ttl`,rel:'describedby',title:'Canonical full knowledge graph — Turtle',type:'text/turtle'},
  {href:`${canonical}llms.txt`,rel:'describedby',title:'Machine-readable entity guide',type:'text/plain'},
  {href:`${canonical}index.md`,rel:'alternate',title:'Markdown projection',type:'text/markdown'},
  {href:`${canonical}llms-full.txt`,rel:'alternate',title:'Full text projection',type:'text/plain'},
  {href:`${canonical}doctor.vcf`,rel:'related',title:'Physician vCard',type:'text/vcard'},
  {href:`${canonical}clinic.vcf`,rel:'related',title:'Clinic vCard',type:'text/vcard'},
  {href:release.primaryEntity.id,rel:'author'},
  {href:release.primaryEntity.id,rel:'about'},
  {href:release.clinic.id,rel:'about'},
  ...identityLinks,
  {href:`https://www.wikidata.org/entity/${release.dataset.supportingClinicWikidata}`,rel:'about',title:'Wikidata — clinic'},
  {href:`https://www.google.com/maps?cid=${release.clinic.cid}`,rel:'about',title:'Google Maps — clinic'},
  {href:'https://www.openstreetmap.org/node/13530287096',rel:'about',title:'OpenStreetMap — clinic'},
  {href:`https://www.wikidata.org/entity/${release.dataset.wikidata}`,rel:'related',title:'Wikidata — structured-data project'},
  {href:release.dataset.github.repository,rel:'related',title:'GitHub — canonical repository'},
  {href:`https://doi.org/${versionDoi}`,rel:'related',title:`Zenodo preservation Version DOI ${release.release}`},
  {href:release.dataset.license,rel:'license'},
  {href:'/favicon.svg',rel:'icon',sizes:'any',type:'image/svg+xml'},
  {href:'/favicon.svg',rel:'mask-icon',color:headProfile.themeColor},
  {href:'/site.webmanifest',rel:'manifest'},
  {href:`${canonical}entity-facts.csv`,rel:'describedby',type:'text/csv'},
  {href:`${canonical}answers.txt`,rel:'alternate',type:'text/plain'},
  {href:`${canonical}knowledge.xml`,rel:'alternate',type:'application/xml'},
  {href:release.dataset.huggingFace.dataset,rel:'related'},
  {href:'/linkset.json',rel:'linkset',type:'application/linkset+json'},
  {href:'/datapackage.json',rel:'describedby',type:'application/json'},
  {href:'/void.ttl',rel:'describedby',type:'text/turtle'},
  {href:'/dcat.ttl',rel:'describedby',type:'text/turtle'},
  {href:'/croissant.json',rel:'describedby',type:'application/ld+json'},
  {href:`${canonical}provenance.jsonld`,rel:'describedby',title:'Claim and passage provenance graph',type:'application/ld+json'},
  {href:`${canonical}evidence-snapshot.json`,rel:'describedby',title:'Release evidence health snapshot',type:'application/json'},
  {href:`${canonical}shapes.ttl`,rel:'describedby',title:'SHACL entity constitution',type:'text/turtle'},
  {href:`${canonical}artifact-manifest.json`,rel:'describedby',title:'Integrity and provenance manifest',type:'application/json'}
];
---
{isMain&&stage==='critical'&&<>
<meta content="width=device-width,initial-scale=1,viewport-fit=cover" name="viewport" />
<link as="image" fetchpriority="high" href={HERO_PRELOAD_HREF} imagesizes={HERO_IMAGE_SIZES} imagesrcset={HERO_PRELOAD_SRCSET} rel="preload" type="image/avif" />
<title>{title}</title><meta content={description} name="description" /><meta content={robots} name="robots" /><meta content={robots} name="googlebot" /><meta content={robots} name="bingbot" />
<meta content="8n4oKDWVkFyp-dUWoTAnLVO1HTr4ARpSPEVngAvybCQ" name="google-site-verification" /><meta content={headProfile.author} name="author" /><meta content={headProfile.applicationName} name="application-name" /><meta content={headProfile.appleMobileWebAppTitle} name="apple-mobile-web-app-title" />
<meta content="telephone=no" name="format-detection" /><meta content="light" name="color-scheme" /><meta content={headProfile.themeColor} name="theme-color" /><meta content={headProfile.themeColor} name="msapplication-TileColor" /><meta content="/browserconfig.xml" name="msapplication-config" />
<link as="font" crossorigin="anonymous" href="/fonts/vazirmatn-nl-wght.cdef5578ea58.woff2" media="(min-width:48.01rem)" rel="preload" type="font/woff2" />
<link href={canonicalURL.toString()} rel="canonical" /><link href={canonicalURL.toString()} hreflang={lang} rel="alternate" />
</>}
{isMain&&stage==='discovery'&&<>
{discoveryLinks.map(link=><link {...link} />)}
<meta content={og.type} property="og:type" /><meta content="Saeed" property="profile:first_name" /><meta content="Ghezelbash" property="profile:last_name" /><meta content="doctor.ghezelbaash" property="profile:username" />
<meta content={og.locale} property="og:locale" />{og.alternateLocales.map(locale=><meta content={locale} property="og:locale:alternate" />)}
<meta content={title} property="og:title" /><meta content={description} property="og:description" /><meta content={canonicalURL.toString()} property="og:url" /><meta content={og.siteName} property="og:site_name" />
<meta content={og.image} property="og:image" /><meta content={og.image} property="og:image:secure_url" /><meta content={og.imageType} property="og:image:type" /><meta content={String(og.imageWidth)} property="og:image:width" /><meta content={String(og.imageHeight)} property="og:image:height" /><meta content={og.imageAlt} property="og:image:alt" />
<meta content={headProfile.twitter.card} name="twitter:card" /><meta content={title} name="twitter:title" /><meta content={description} name="twitter:description" /><meta content={canonicalURL.toString()} name="twitter:url" /><meta content={og.image} name="twitter:image" /><meta content={og.imageAlt} name="twitter:image:alt" />
</>}
{!isMain&&stage==='critical'&&<>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>{title}</title><meta name="description" content={description} /><meta name="robots" content={robots} />
<meta name="author" content="دکتر سعید قزلباش" /><meta name="theme-color" content="#075244" />
<link rel="canonical" href={canonicalURL.toString()} /><link rel="icon" href="/favicon.svg" sizes="any" type="image/svg+xml" />
</>}
