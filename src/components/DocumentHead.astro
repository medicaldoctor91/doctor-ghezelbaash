---
import documentHead from '../data/document-head.json';
import release from '../data/release.json';
import authorityProfile from '../data/semantic/authority-profile.json';
import {
  HERO_IMAGE_SIZES,
  HERO_PRELOAD_SRCSET,
} from '../lib/hero-image-contract.mjs';
import { deriveCanonicalAuthority } from '../lib/canonical-authority.mjs';
import { canonicalGraph } from '../lib/knowledge-graph';
import { HEAD_RESOURCES } from '../lib/resources.mjs';
import {
  exactLanguageLiteral,
  indexCanonicalGraph,
} from '../lib/semantic-projection.mjs';

type DiscoveryLink = {
  href: string;
  rel: string;
  title?: string;
  type?: string;
  color?: string;
};

type GraphNode = Record<string, any> & { '@id': string };

interface Props {
  title: string;
  description: string;
  robots: string;
  canonicalURL: URL | undefined;
  isMain: boolean;
}

const authority = deriveCanonicalAuthority(release, canonicalGraph, authorityProfile);
const legacyIdentityMesh = release.primaryEntity.verifiedWebIdentityMesh.map(String);
if (
  JSON.stringify(legacyIdentityMesh) !==
  JSON.stringify(authority.primaryEntity.verifiedWebIdentityMesh)
) {
  throw new Error('Release identity-mesh shadow differs from canonical graph authority');
}
if (String(release.clinic.cid) !== String(authority.clinicAuthority.cid)) {
  throw new Error('Release clinic-CID shadow differs from canonical graph authority');
}
const { title, description, robots, canonicalURL, isMain } = Astro.props;
const canonicalUrl = canonicalURL?.toString();
if (isMain && canonicalUrl !== release.canonicalUrl) {
  throw new Error('Canonical page URL drift');
}
if (
  isMain &&
  !/(?:^|,)\s*max-image-preview:large\s*(?:,|$)/i.test(robots)
) {
  throw new Error('Canonical robots policy must declare max-image-preview:large');
}

const graphNodes = canonicalGraph['@graph'] as GraphNode[];
const { byId: nodeById } = indexCanonicalGraph(canonicalGraph) as {
  byId: Map<string, GraphNode>;
};
const exactUrl = (value: unknown, pattern: RegExp, label: string) => {
  const matches = (Array.isArray(value) ? value : [value]).filter(
    (item): item is string => typeof item === 'string' && pattern.test(item),
  );
  if (matches.length !== 1) {
    throw new Error(`Canonical graph must define one ${label}`);
  }
  return matches[0];
};
const exactText = (value: unknown, label: string) => {
  if (typeof value !== 'string' || !value.trim() || value !== value.trim()) {
    throw new Error(`Canonical graph must define one normalized ${label}`);
  }
  return value;
};
const quantityValue = (value: unknown, label: string) => {
  const numeric = Number((value as { value?: unknown } | undefined)?.value);
  if (!Number.isInteger(numeric) || numeric < 1) {
    throw new Error(`Canonical graph must define one positive ${label}`);
  }
  return numeric;
};
const nodeHasType = (node: GraphNode, type: string) =>
  (Array.isArray(node['@type']) ? node['@type'] : [node['@type']]).includes(type);

const person = authority.person as GraphNode;
const clinic = authority.clinic as GraphNode;
const website = authority.website as GraphNode;
const profileFirstName = exactLanguageLiteral(
  person.givenName,
  'en',
  'Canonical physician givenName',
);
const profileLastName = exactLanguageLiteral(
  person.familyName,
  'en',
  'Canonical physician familyName',
);
const authorName = exactLanguageLiteral(
  person.name,
  'fa',
  'Canonical physician Persian name',
);
const applicationName = exactText(website.name, 'WebSite name');
const instagramUrl = exactUrl(
  person.sameAs,
  /^https:\/\/www\.instagram\.com\/[A-Za-z0-9._-]+\/?$/,
  'official Instagram profile',
);
const profileUsername = new URL(instagramUrl).pathname
  .split('/')
  .filter(Boolean)[0];
const clinicIdentifierNodes = (Array.isArray(clinic.identifier)
  ? clinic.identifier
  : [clinic.identifier]
)
  .map((reference) =>
    typeof reference === 'object' &&
    reference !== null &&
    typeof reference['@id'] === 'string'
      ? nodeById.get(reference['@id'])
      : undefined,
  )
  .filter((node): node is GraphNode => Boolean(node));
const openStreetMapUrl = exactUrl(
  clinicIdentifierNodes.map((node) => node.url),
  /^https:\/\/www\.openstreetmap\.org\/node\/\d+$/,
  'clinic OpenStreetMap identifier',
);
const socialImageCandidates = graphNodes.filter(
  (node) =>
    nodeHasType(node, 'ImageObject') &&
    quantityValue(node.width, `${node['@id']} width`) === 1200 &&
    quantityValue(node.height, `${node['@id']} height`) === 630 &&
    typeof node.contentUrl === 'string' &&
    new URL(node.contentUrl).origin === new URL(release.canonicalUrl).origin,
);
if (socialImageCandidates.length !== 1) {
  throw new Error(
    `Canonical graph must define exactly one 1200x630 social ImageObject; found ${socialImageCandidates.length}`,
  );
}
const [socialImage] = socialImageCandidates;
const og = Object.freeze({
  ...documentHead.openGraph,
  image: exactText(socialImage.contentUrl, 'social ImageObject contentUrl'),
  imageType: exactText(socialImage.encodingFormat, 'social ImageObject encodingFormat'),
  imageWidth: quantityValue(socialImage.width, 'social ImageObject width'),
  imageHeight: quantityValue(socialImage.height, 'social ImageObject height'),
});

const faviconPng = '/favicon.png';
const canonical = release.canonicalUrl;
const versionDoi = release.dataset.zenodo.versionDoi;
const physicianId = authority.primaryEntity.id;
const clinicId = authority.clinicAuthority.id;

const machineLinks: DiscoveryLink[] = HEAD_RESOURCES.map((resource) => {
  if (typeof resource.headRel !== 'string' || !resource.headRel) {
    throw new Error(`Machine resource missing Head relation: ${resource.path}`);
  }
  return {
    href: `${canonical}${resource.path}`,
    rel: resource.headRel,
    type: resource.contentType,
    title:
      'headTitle' in resource && typeof resource.headTitle === 'string'
        ? resource.headTitle
        : undefined,
  };
});
const identityLinks: DiscoveryLink[] =
  authority.primaryEntity.verifiedWebIdentityMesh.map((href: string) => ({
    href,
    rel: 'me',
  }));
const discoveryLinks: DiscoveryLink[] = [
  ...machineLinks,
  { href: physicianId, rel: 'author' },
  { href: physicianId, rel: 'about' },
  { href: clinicId, rel: 'about' },
  ...identityLinks,
  {
    href: `https://www.google.com/maps?cid=${authority.clinicAuthority.cid}`,
    rel: 'about',
    title: 'Google Maps — clinic',
  },
  {
    href: openStreetMapUrl,
    rel: 'about',
    title: 'OpenStreetMap — clinic',
  },
  {
    href: release.dataset.github.repository,
    rel: 'related',
    title: 'GitHub — canonical repository',
  },
  {
    href: `https://doi.org/${versionDoi}`,
    rel: 'related',
    title: `Zenodo preservation Version DOI ${release.release}`,
  },
  { href: release.dataset.license, rel: 'license' },
  {
    href: '/favicon.svg',
    rel: 'mask-icon',
    color: documentHead.themeColor,
  },
  { href: '/site.webmanifest', rel: 'manifest' },
  { href: release.dataset.huggingFace.dataset, rel: 'related' },
];
---

<meta content="width=device-width,initial-scale=1,viewport-fit=cover" name="viewport">
{
  isMain && (
    <link
      as="image"
      fetchpriority="high"
      imagesizes={HERO_IMAGE_SIZES}
      imagesrcset={HERO_PRELOAD_SRCSET}
      rel="preload"
      type="image/avif"
    >
  )
}
<link href={faviconPng} rel="icon" sizes="192x192" type="image/png">
{isMain && <link href="/apple-touch-icon.png" rel="apple-touch-icon">}
<title>{title}</title>
<meta content={description} name="description">
<meta content={robots} name="robots">
{
  isMain && (
    <meta
      content="8n4oKDWVkFyp-dUWoTAnLVO1HTr4ARpSPEVngAvybCQ"
      name="google-site-verification"
    >
  )
}
<meta content={authorName} name="author">
{isMain && <meta content={applicationName} name="application-name">}
{
  isMain && (
    <meta
      content={documentHead.appleMobileWebAppTitle}
      name="apple-mobile-web-app-title"
    >
  )
}
{isMain && <meta content="telephone=no" name="format-detection">}
{isMain && <meta content="light" name="color-scheme">}
<meta content={documentHead.themeColor} name="theme-color">
{
  isMain && (
    <link
      as="font"
      crossorigin="anonymous"
      href="/fonts/vazirmatn-nl-wght.cdef5578ea58.woff2"
      media="(min-width:48.01rem)"
      rel="preload"
      type="font/woff2"
    >
  )
}
{canonicalUrl && <link href={canonicalUrl} rel="canonical">}
<slot />
{
  isMain && (
    <>
      {discoveryLinks.map((link) => <link {...link}>)}
      <meta content={og.type} property="og:type">
      <meta content={profileFirstName} property="profile:first_name">
      <meta content={profileLastName} property="profile:last_name">
      <meta content={profileUsername} property="profile:username">
      <meta content={og.locale} property="og:locale">
      {og.alternateLocales.map((locale) => (
        <meta content={locale} property="og:locale:alternate">
      ))}
      <meta content={title} property="og:title">
      <meta content={description} property="og:description">
      <meta content={canonicalUrl} property="og:url">
      <meta content={applicationName} property="og:site_name">
      <meta content={og.image} property="og:image">
      <meta content={og.image} property="og:image:secure_url">
      <meta content={og.imageType} property="og:image:type">
      <meta content={String(og.imageWidth)} property="og:image:width">
      <meta content={String(og.imageHeight)} property="og:image:height">
      <meta content={og.imageAlt} property="og:image:alt">
      <meta content={documentHead.twitter.card} name="twitter:card">
      <meta content={title} name="twitter:title">
      <meta content={description} name="twitter:description">
      <meta content={canonicalUrl} name="twitter:url">
      <meta content={og.image} name="twitter:image">
      <meta content={og.imageAlt} name="twitter:image:alt">
    </>
  )
}
