---
import mainHeadRaw from '../data/templates/main-head.html?raw';
import release from '../data/release.json';
import { deriveMainHeadStages } from '../lib/head-delivery.mjs';
import { bindHeroPreloadSizes } from '../lib/hero-image-contract.mjs';
import { bindReleaseTokens } from '../lib/release-tokens.mjs';
type HeadStage='critical'|'discovery';
interface Props { title: string; description: string; robots: string; canonicalURL: URL; isMain?: boolean; stage?: HeadStage; }
const { title, description, robots, canonicalURL, isMain=false, stage='critical' } = Astro.props;
if(stage!=='critical'&&stage!=='discovery')throw new Error(`Unknown DocumentHead stage: ${stage}`);
const mainHead=bindReleaseTokens(bindHeroPreloadSizes(mainHeadRaw),release);
const viewportPattern=/^<meta\b(?=[^>]*\bname="viewport")[^>]*\/>/i;
const heroPreloadPattern=/<link\b(?=[^>]*\brel="preload")(?=[^>]*\bas="image")(?=[^>]*\bfetchpriority="high")(?=[^>]*\bimagesrcset=)(?=[^>]*saeed-ghezelbash-portrait-delivery-640)[^>]*\/>/i;
const viewportTag=mainHead.match(viewportPattern)?.[0]??'';
const heroPreloadTag=mainHead.match(heroPreloadPattern)?.[0]??'';
if(isMain&&(!viewportTag||!heroPreloadTag||mainHead.match(new RegExp(heroPreloadPattern.source,'gi'))?.length!==1))throw new Error('Main responsive Hero preload contract drift');
if(isMain&&!mainHead.startsWith(`${viewportTag}${heroPreloadTag}`))throw new Error('Main Head template critical-hint order drift');
const {criticalHead,discoveryHead}=deriveMainHeadStages(mainHead);
const stagedMainHead=stage==='critical'?criticalHead:discoveryHead;
---
{isMain&&<Fragment set:html={stagedMainHead} />}
{!isMain&&stage==='critical'&&<>
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>{title}</title><meta name="description" content={description} /><meta name="robots" content={robots} />
<meta name="author" content="دکتر سعید قزلباش" /><meta name="theme-color" content="#075244" />
<link rel="canonical" href={canonicalURL} /><link rel="icon" href="/favicon.svg" sizes="any" type="image/svg+xml" />
</>}
