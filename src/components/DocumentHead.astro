---
import documentHead from '../data/document-head.json';
import release from '../data/release.json';
import {
  HERO_IMAGE_SIZES,
  HERO_PRELOAD_SRCSET,
} from '../lib/hero-image-contract.mjs';
import { deriveCanonicalAuthority, selectCanonicalSocialImage } from '../lib/canonical-authority.mjs';
import { canonicalGraph } from '../lib/knowledge-graph';
import { HEAD_RESOURCES } from '../lib/resources.mjs';
import { exactLanguageLiteral, refId, values } from '../lib/graph-core.mjs';

type DiscoveryLink = {
  href: string;
  rel: string;
  title?: string;
  type?: string;
  color?: string;
};

type GraphNode = Record<string, unknown> & { '@id': string };

interface Props {
  title: string;
  description: string;
  lang: string;
  robots: string;
  socialImageAlt?: string;
  socialAlternateLocales?: string[];
  canonicalURL: URL | undefined;
  isMain: boolean;
}

const authority = deriveCanonicalAuthority(release, canonicalGraph);
const {
  title,
  description,
  lang,
  robots,
  socialImageAlt,
  socialAlternateLocales,
  canonicalURL,
  isMain,
} = Astro.props;
const canonicalUrl = canonicalURL?.toString();
if (isMain && canonicalUrl !== release.canonicalUrl) {
  throw new Error('Canonical page URL drift');
}
if (
  isMain &&
  !/(?:^|,)\s*max-image-preview:large\s*(?:,|$)/i.test(robots)
) {
  throw new Error('Canonical robots policy must declare max-image-preview:large');
}

const facts = authority.facts;
const person = facts.person as GraphNode;
const website = facts.website as GraphNode;
const page = facts.page as GraphNode;
const pageTypes = Array.isArray(page['@type']) ? page['@type'] : [page['@type']];
const openGraphType = pageTypes.includes('ProfilePage') ? 'profile' : '';
if (isMain && !openGraphType) {
  throw new Error('Canonical page must project Open Graph profile from graph ProfilePage type');
}
const pageLanguages = (Array.isArray(page.inLanguage) ? page.inLanguage : [page.inLanguage])
  .filter((value): value is string => typeof value === 'string' && value.length > 0);
if (isMain && !pageLanguages.includes(lang)) {
  throw new Error(`Canonical page language is not declared by graph: ${lang}`);
}
const openGraphLocaleMatch = /^([a-z]{2,3})-([A-Z]{2})$/.exec(lang);
if (isMain && !openGraphLocaleMatch) {
  throw new Error(`Canonical page language cannot project an Open Graph locale: ${lang}`);
}
const openGraphLocale = openGraphLocaleMatch
  ? `${openGraphLocaleMatch[1]}_${openGraphLocaleMatch[2]}`
  : '';
const alternateLocales = Array.isArray(socialAlternateLocales)
  ? [...socialAlternateLocales]
  : [];
if (isMain) {
  if (typeof socialImageAlt !== 'string' || !socialImageAlt.trim() || socialImageAlt !== socialImageAlt.trim()) {
    throw new Error('Canonical page frontmatter requires normalized socialImageAlt');
  }
  if (!alternateLocales.length || new Set(alternateLocales).size !== alternateLocales.length) {
    throw new Error('Canonical page frontmatter requires unique socialAlternateLocales');
  }
  const graphLanguageBases = new Set(pageLanguages.map((value) => value.split('-')[0]));
  for (const locale of alternateLocales) {
    const match = /^([a-z]{2,3})_([A-Z]{2})$/.exec(locale);
    if (!match || locale === openGraphLocale || !graphLanguageBases.has(match[1])) {
      throw new Error(`Invalid canonical social alternate locale: ${locale}`);
    }
  }
}
const profileFirstName = exactLanguageLiteral(
  person.givenName,
  'en',
  'Canonical physician givenName',
);
const profileLastName = exactLanguageLiteral(
  person.familyName,
  'en',
  'Canonical physician familyName',
);
const authorName = exactLanguageLiteral(
  person.name,
  'fa',
  'Canonical physician Persian name',
);
if (typeof website.name !== 'string' || !website.name.trim() || website.name !== website.name.trim()) {
  throw new Error('Canonical graph must define one normalized WebSite name');
}
const applicationName = website.name;
const websiteDisplayNames = new Set([
  applicationName,
  ...values(website.alternateName).filter(
    (value): value is string => typeof value === 'string' && value.length > 0,
  ),
]);
if (isMain && !websiteDisplayNames.has(documentHead.appleMobileWebAppTitle)) {
  throw new Error('Apple web-app title must select a canonical WebSite name from the graph');
}
const profileUsername = new URL(facts.instagramUrl).pathname
  .split('/')
  .filter(Boolean)[0];
const openStreetMapUrl = facts.openStreetMapUrl;
const socialImage = selectCanonicalSocialImage(release, canonicalGraph);
const og = Object.freeze({
  type: openGraphType,
  locale: openGraphLocale,
  alternateLocales: Object.freeze(alternateLocales),
  image: socialImage.contentUrl,
  imageType: socialImage.encodingFormat,
  imageWidth: socialImage.width,
  imageHeight: socialImage.height,
  imageAlt: socialImageAlt ?? '',
});

const faviconPng = '/favicon.png';
const canonical = release.canonicalUrl;
const versionDoi = release.dataset.zenodo.versionDoi;
const physicianId = refId(page.author);
if (isMain && physicianId !== authority.primaryEntity.id) {
  throw new Error('Canonical graph page author must be the primary physician');
}
const pageAboutIds = values(page.about).map((reference) => refId(reference));
if (isMain && !pageAboutIds.includes(physicianId)) {
  throw new Error('Canonical graph page about relations must include its physician author');
}
const clinicId = authority.clinicAuthority.id;
const pageMentionIds = values(page.mentions).map((reference) => refId(reference));
if (isMain && !pageMentionIds.includes(clinicId)) {
  throw new Error('Canonical graph page mentions must include the canonical clinic');
}
const googleMapsUrl = `https://www.google.com/maps?cid=${authority.clinicAuthority.cid}`;
const clinicSameAs = new Set(
  values(facts.clinic.sameAs).filter(
    (value): value is string => typeof value === 'string' && value.length > 0,
  ),
);
if (isMain && (!clinicSameAs.has(googleMapsUrl) || !clinicSameAs.has(openStreetMapUrl))) {
  throw new Error('Canonical clinic identity mesh must contain Google Maps and OpenStreetMap');
}

const machineLinks: DiscoveryLink[] = HEAD_RESOURCES.map((resource) => {
  if (typeof resource.headRel !== 'string' || !resource.headRel) {
    throw new Error(`Machine resource missing Head relation: ${resource.path}`);
  }
  return {
    href: `${canonical}${resource.path}`,
    rel: resource.headRel,
    type: resource.contentType,
    title:
      'headTitle' in resource && typeof resource.headTitle === 'string'
        ? resource.headTitle
        : undefined,
  };
});
const identityLinks: DiscoveryLink[] =
  authority.primaryEntity.verifiedWebIdentityMesh.map((href: string) => ({
    href,
    rel: 'me',
  }));
const discoveryLinks: DiscoveryLink[] = [
  ...machineLinks,
  { href: physicianId as string, rel: 'author' },
  { href: physicianId as string, rel: 'about' },
  { href: clinicId, rel: 'about' },
  ...identityLinks,
  {
    href: googleMapsUrl,
    rel: 'about',
    title: 'Google Maps — clinic',
  },
  {
    href: openStreetMapUrl,
    rel: 'about',
    title: 'OpenStreetMap — clinic',
  },
  {
    href: release.dataset.github.repository,
    rel: 'related',
    title: 'GitHub — canonical repository',
  },
  {
    href: `https://doi.org/${versionDoi}`,
    rel: 'related',
    title: `Zenodo preservation Version DOI ${release.release}`,
  },
  { href: release.dataset.license, rel: 'license' },
  {
    href: '/favicon.svg',
    rel: 'mask-icon',
    color: documentHead.themeColor,
  },
  { href: '/site.webmanifest', rel: 'manifest' },
  { href: release.dataset.huggingFace.dataset, rel: 'related' },
];
---

<meta content="width=device-width,initial-scale=1,viewport-fit=cover" name="viewport">
{
  isMain && (
    <link
      as="image"
      fetchpriority="high"
      imagesizes={HERO_IMAGE_SIZES}
      imagesrcset={HERO_PRELOAD_SRCSET}
      rel="preload"
      type="image/avif"
    >
  )
}
<link href={faviconPng} rel="icon" sizes="192x192" type="image/png">
{isMain && <link href="/apple-touch-icon.png" rel="apple-touch-icon">}
<title>{title}</title>
<meta content={description} name="description">
<meta content={robots} name="robots">
{
  isMain && (
    <meta
      content="8n4oKDWVkFyp-dUWoTAnLVO1HTr4ARpSPEVngAvybCQ"
      name="google-site-verification"
    >
  )
}
<meta content={authorName} name="author">
{isMain && <meta content={applicationName} name="application-name">}
{
  isMain && (
    <meta
      content={documentHead.appleMobileWebAppTitle}
      name="apple-mobile-web-app-title"
    >
  )
}
{isMain && <meta content="telephone=no" name="format-detection">}
{isMain && <meta content="light" name="color-scheme">}
<meta content={documentHead.themeColor} name="theme-color">
{
  isMain && (
    <link
      as="font"
      crossorigin="anonymous"
      href="/fonts/vazirmatn-nl-wght.cdef5578ea58.woff2"
      media="(min-width:48.01rem)"
      rel="preload"
      type="font/woff2"
    >
  )
}
{canonicalUrl && <link href={canonicalUrl} rel="canonical">}
<slot />
{
  isMain && (
    <>
      {discoveryLinks.map((link) => <link {...link}>)}
      <meta content={og.type} property="og:type">
      <meta content={profileFirstName} property="profile:first_name">
      <meta content={profileLastName} property="profile:last_name">
      <meta content={profileUsername} property="profile:username">
      <meta content={og.locale} property="og:locale">
      {og.alternateLocales.map((locale) => (
        <meta content={locale} property="og:locale:alternate">
      ))}
      <meta content={title} property="og:title">
      <meta content={description} property="og:description">
      <meta content={canonicalUrl} property="og:url">
      <meta content={applicationName} property="og:site_name">
      <meta content={og.image} property="og:image">
      <meta content={og.image} property="og:image:secure_url">
      <meta content={og.imageType} property="og:image:type">
      <meta content={String(og.imageWidth)} property="og:image:width">
      <meta content={String(og.imageHeight)} property="og:image:height">
      <meta content={og.imageAlt} property="og:image:alt">
      <meta content={documentHead.twitter.card} name="twitter:card">
      <meta content={title} name="twitter:title">
      <meta content={description} name="twitter:description">
      <meta content={canonicalUrl} name="twitter:url">
      <meta content={og.image} name="twitter:image">
      <meta content={og.imageAlt} name="twitter:image:alt">
    </>
  )
}