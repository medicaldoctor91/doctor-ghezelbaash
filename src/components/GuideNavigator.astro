---
import release from '../data/release.json';
const entityAliases=[...release.primaryEntity.officialAliases,...(release.primaryEntity.reconciliationAliases||[]),...release.primaryEntity.retrievalVariants].join('|');
---
<dialog aria-labelledby="guide-search-title" class="guide-search" data-entity-aliases={entityAliases} id="guide-search">
  <div class="guide-search__panel">
    <header class="guide-search__header">
      <div><p class="guide-search__eyebrow">راهنمای یک‌صفحه‌ای</p><h2 id="guide-search-title">جست‌وجوی سریع در محتوای پزشکی زیبایی</h2></div>
      <button aria-label="بستن جست‌وجو" class="guide-search__close" data-guide-search-close type="button">×</button>
    </header>
    <label class="guide-search__field" for="guide-search-input"><span>نام درمان، عارضه یا سؤال را بنویسید</span><input autocomplete="off" enterkeyhint="search" id="guide-search-input" inputmode="search" placeholder="مثلاً فیلر زیر چشم، افتادگی پلک یا عارضه بوتاکس" type="search" /></label>
    <p aria-live="polite" class="guide-search__status" id="guide-search-status">عنوان‌های H2 تا H4 همین صفحه جست‌وجو می‌شوند. کلید / نیز جست‌وجو را باز می‌کند.</p>
    <ol class="guide-search__results" id="guide-search-results"></ol>
    <noscript><p>برای جست‌وجوی درون‌صفحه‌ای از قابلیت Find مرورگر استفاده کنید. فهرست مطالب کامل بدون جاوااسکریپت در صفحه فعال است.</p></noscript>
  </div>
</dialog>
<script is:inline id="site-runtime">
(()=>{const d=document,s=d.documentElement;s.classList.add('js');const norm=v=>(v||'').toLocaleLowerCase('fa').replace(/[يى]/g,'ی').replace(/ك/g,'ک').replace(/[\u200c\u200f\u200e]/g,' ').replace(/[^\p{L}\p{N}\s-]/gu,' ').replace(/\s+/g,' ').trim(),dialog=d.getElementById('guide-search'),input=d.getElementById('guide-search-input'),results=d.getElementById('guide-search-results'),status=d.getElementById('guide-search-status'),deferredConfig=d.getElementById('deferred-content-config');let index,deferredStylePromise,deferredHydrationStarted=false;const aliasKeys=(dialog?.dataset.entityAliases||'').split('|').map(norm).filter(Boolean),build=()=>index??=[...d.querySelectorAll('main h2[id],main h3[id],main h4[id]')].filter(x=>!x.closest('.guide-search')).map(x=>{const text=x.textContent.trim(),headingAlias=x.dataset.retrievalAlias||'',level=Number(x.tagName.slice(1)),entity=/سعید\s*قزلباش|Saeed\s+Ghezelbash/i.test(text+' '+headingAlias);return{id:x.id,text,level,key:norm(text+' '+headingAlias)+(entity?' '+aliasKeys.join(' '):'')}});const score=(x,q)=>{const key=x.key,base=key===q?0:key.startsWith(q)?1:key.split(' ').some(t=>t.startsWith(q))?2:key.includes(q)?3:99;return base===99?99:base*10+x.level};const render=()=>{const q=norm(input.value);results.replaceChildren();if(q.length<2){status.textContent='برای جست‌وجوی دقیق‌تر دست‌کم دو حرف وارد کنید.';return}const hits=build().map(x=>({...x,rank:score(x,q)})).filter(x=>x.rank<99).sort((a,b)=>a.rank-b.rank||a.text.length-b.text.length).slice(0,24);for(const hit of hits){const li=d.createElement('li'),a=d.createElement('a');a.href='#'+hit.id;a.textContent=hit.text;a.addEventListener('click',()=>dialog.close(),{once:true});li.append(a);results.append(li)}status.textContent=hits.length?`${hits.length} نتیجه از عنوان‌های صفحه پیدا شد.`:'نتیجه‌ای پیدا نشد؛ واژه کوتاه‌تر یا مترادف را امتحان کنید.'};const decodeDeferred=v=>{v=String(v||'').trim();if((v.startsWith('"')&&v.endsWith('"'))||(v.startsWith("'")&&v.endsWith("'")))v=v.slice(1,-1);if(!v)return'';const b=atob(v),u=Uint8Array.from(b,c=>c.charCodeAt(0));return new TextDecoder().decode(u)},loadDeferredStyle=()=>{if(!deferredConfig?.dataset.css)return Promise.resolve(false);return deferredStylePromise??=new Promise((resolve,reject)=>{const existing=d.querySelector('link[data-deferred-content-stylesheet]');if(existing){if(existing.sheet)return resolve(true);existing.addEventListener('load',()=>resolve(true),{once:true});existing.addEventListener('error',reject,{once:true});return}const l=d.createElement('link');l.rel='stylesheet';l.href=deferredConfig.dataset.css;l.dataset.deferredContentStylesheet='';l.addEventListener('load',()=>resolve(true),{once:true});l.addEventListener('error',reject,{once:true});d.head.append(l)}).catch(()=>false)},hydratePlaceholder=ph=>{if(!ph?.isConnected)return false;const id=ph.dataset.deferredFragment;if(!id)return false;const encoded=getComputedStyle(deferredConfig).getPropertyValue('--'+id);if(!encoded)return false;const html=decodeDeferred(encoded);if(!html)return false;const t=d.createElement('template');t.innerHTML=html;ph.replaceWith(t.content);index=undefined;return true},hydrateTarget=id=>{const target=id&&d.getElementById(id),ph=target?.closest?.('[data-deferred-fragment]');if(!ph)return Promise.resolve(false);return loadDeferredStyle().then(ok=>ok&&hydratePlaceholder(ph))},idle=fn=>('requestIdleCallback'in window?requestIdleCallback(fn,{timeout:1200}):setTimeout(()=>fn({timeRemaining:()=>8,didTimeout:true}),32)),startDeferredHydration=()=>{if(deferredHydrationStarted||!deferredConfig)return;deferredHydrationStarted=true;loadDeferredStyle().then(ok=>{if(!ok)return;const pump=deadline=>{let n=0;while(n<2&&(deadline.didTimeout||deadline.timeRemaining()>4)){const ph=d.querySelector('[data-deferred-fragment]');if(!ph)break;hydratePlaceholder(ph);n++}initPosters();syncTarget();if(d.querySelector('[data-deferred-fragment]'))idle(pump)};idle(pump)})},open=()=>{startDeferredHydration();if(!dialog.open)dialog.showModal();requestAnimationFrame(()=>input.focus())};d.addEventListener('click',e=>{const internal=e.target.closest?.('a[href^="#"]');if(internal){let id;try{id=decodeURIComponent(internal.getAttribute('href').slice(1))}catch{id=internal.getAttribute('href').slice(1)}const target=id&&d.getElementById(id),ph=target?.closest?.('[data-deferred-fragment]');if(ph){e.preventDefault();loadDeferredStyle().then(ok=>{if(ok)hydratePlaceholder(ph);const real=id&&d.getElementById(id);if(real){history.pushState(null,'','#'+encodeURIComponent(id));real.scrollIntoView({block:'start'});syncTarget()}})}}if(e.target.closest('[data-guide-search-open]'))open();if(e.target.closest('[data-guide-search-close]'))dialog.close()});d.addEventListener('keydown',e=>{if(e.key==='/'&&!e.metaKey&&!e.ctrlKey&&!e.altKey&&!/^(INPUT|TEXTAREA|SELECT)$/.test(d.activeElement?.tagName)&&!d.activeElement?.isContentEditable){e.preventDefault();open()}});input?.addEventListener('input',render);dialog?.addEventListener('click',e=>{if(e.target===dialog)dialog.close()});const syncTarget=()=>{d.querySelector('.render-chunk.is-target-chunk')?.classList.remove('is-target-chunk');if(!location.hash)return;let id;try{id=decodeURIComponent(location.hash.slice(1))}catch{id=location.hash.slice(1)}d.getElementById(id)?.closest('.render-chunk')?.classList.add('is-target-chunk')};addEventListener('hashchange',()=>{let id;try{id=decodeURIComponent(location.hash.slice(1))}catch{id=location.hash.slice(1)}hydrateTarget(id).then(syncTarget)},{passive:true});syncTarget();const revealPoster=video=>{if(!video.poster&&video.dataset.poster)video.poster=video.dataset.poster};let posterObserver;const initPosters=()=>{const videos=[...d.querySelectorAll('video[data-poster]:not([data-poster-observed])'];if(!videos.length)return;if('IntersectionObserver'in window){posterObserver??=new IntersectionObserver(entries=>{for(const entry of entries)if(entry.isIntersecting){revealPoster(entry.target);posterObserver.unobserve(entry.target)}},{rootMargin:'600px 0px'});for(const video of videos){video.dataset.posterObserved='';posterObserver.observe(video)}}else{for(const video of videos){video.dataset.posterObserved='';revealPoster(video)}}};initPosters();const p=new URLSearchParams(location.search),slug=p.get('video'),seconds=Number(p.get('t')),seekVideo=()=>{if(!slug)return;const id='video-saeed-ghezelbash-'+slug,target=d.getElementById(id),ph=target?.closest?.('[data-deferred-fragment]');const go=()=>{const video=d.getElementById(id);if(!video||video.tagName!=='VIDEO')return;revealPoster(video);video.preload='metadata';const seek=()=>{if(Number.isFinite(seconds)&&seconds>=0)video.currentTime=Math.min(seconds,Number.isFinite(video.duration)?video.duration:seconds);video.closest('figure')?.classList.add('video-deeplink-target');video.scrollIntoView({block:'center'});video.focus({preventScroll:true})};video.readyState>=1?seek():video.addEventListener('loadedmetadata',seek,{once:true})};ph?loadDeferredStyle().then(ok=>{if(ok)hydratePlaceholder(ph);go()}):go()};seekVideo();if(deferredConfig){const userStart=()=>startDeferredHydration();addEventListener('scroll',userStart,{once:true,passive:true});d.addEventListener('pointerdown',userStart,{once:true,capture:true,passive:true});d.addEventListener('keydown',userStart,{once:true,capture:true});addEventListener('load',()=>setTimeout(startDeferredHydration,7000),{once:true});if(location.hash){let id;try{id=decodeURIComponent(location.hash.slice(1))}catch{id=location.hash.slice(1)}hydrateTarget(id).then(syncTarget)}}})();
</script>