---
import rawRelease from '../data/release.json';
import { deriveCanonicalAuthority } from '../lib/canonical-authority.mjs';
import { canonicalGraph } from '../lib/knowledge-graph';
import queryMatrixPolicy from '../data/retrieval/query-matrix-policy.json';

const authority = deriveCanonicalAuthority(rawRelease, canonicalGraph);
const entityAliases = [
  ...authority.primaryEntity.officialAliases,
  ...authority.primaryEntity.reconciliationAliases,
  ...authority.primaryEntity.retrievalVariants,
].join('|');
const intentTargets = Object.fromEntries(
  Object.entries(queryMatrixPolicy.intentAnswerIds).map(([intent, url]) => [
    intent,
    new URL(url).hash.slice(1),
  ]),
);
---

<search
  aria-label="جست‌وجوی درون راهنمای پزشکی زیبایی"
  class="guide-search"
  data-entity-aliases={entityAliases}
  data-intent-targets={JSON.stringify(intentTargets)}
  id="guide-search"
>
  <label class="guide-search__field" for="guide-search-input">
    <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24">
      <circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4 4"></path>
    </svg>
    <input
      aria-controls="guide-search-results"
      aria-describedby="guide-search-status"
      aria-label="جست‌وجو در راهنمای پزشکی زیبایی"
      autocomplete="off"
      enterkeyhint="search"
      id="guide-search-input"
      inputmode="search"
      placeholder="بوتاکس، فیلر، عوارض یا انتخاب پزشک…"
      type="search"
    >
    <kbd aria-hidden="true">/</kbd>
  </label>
  <p aria-live="polite" class="guide-search__status" id="guide-search-status">
    عنوان‌های H1 تا H5 و مسیرهای موضوعی همین صفحه جست‌وجو می‌شوند.
  </p>
  <ol aria-label="نتایج جست‌وجوی همین صفحه" class="guide-search__results" hidden id="guide-search-results"></ol>
</search>

<style is:global>
  #guide-search.guide-search{position:relative;z-index:30;grid-area:search;justify-self:center;width:min(100%,34rem);max-height:none;margin:0 auto .35rem;padding:0;border:0;border-radius:0;background:transparent;box-shadow:none}
  #guide-search.guide-search:not([data-mounted]){display:none}
  #guide-search .guide-search__field{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:.55rem;align-items:center;min-height:2.75rem;padding-inline:.82rem .65rem;border:1px solid #c7d8d2;border-radius:999px;background:#fff;font-weight:700}
  #guide-search .guide-search__field:focus-within{border-color:#86b7a8;box-shadow:0 0 0 3px rgb(10 107 88/.1)}
  #guide-search .guide-search__field svg{width:1.05rem;height:1.05rem;fill:none;stroke:var(--accent-strong);stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}
  #guide-search .guide-search__field input{width:100%;min-width:0;min-height:2.65rem;padding:0;border:0;outline:0;background:transparent;color:var(--ink);font:inherit;font-weight:650}
  #guide-search .guide-search__field input::placeholder{color:#687671;opacity:1}
  #guide-search .guide-search__field kbd{padding:.05rem .2rem;border:0;background:none;color:#75827d;font:600 .68rem/1 ui-monospace,SFMono-Regular,Menlo,monospace}
  #guide-search .guide-search__status{position:absolute;width:1px;height:1px;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
  #guide-search .guide-search__results{position:absolute;z-index:40;inset-inline:0;top:calc(100% + .4rem);display:grid;gap:.25rem;max-height:min(46vh,25rem);margin:0;padding:.35rem;overflow:auto;border:1px solid #d4e0dc;border-radius:.8rem;background:#fff;box-shadow:0 16px 42px rgb(17 39 31/.14);list-style:none;overscroll-behavior:contain}
  #guide-search .guide-search__results[hidden]{display:none}
  #guide-search .guide-search__results a{display:grid;gap:.1rem;padding:.58rem .68rem;border:0;border-radius:.55rem;background:transparent;color:var(--ink);text-decoration:none;outline-offset:-3px}
  #guide-search .guide-search__results a:hover,#guide-search .guide-search__results a:focus-visible{background:var(--accent-soft)}
  #guide-search .guide-search__result-title{font-weight:780;line-height:1.5}
  #guide-search .guide-search__result-context{color:var(--muted);font-size:.78rem;line-height:1.4}
  #guide-search .guide-search__empty{padding:.68rem;color:var(--muted);font-size:.9rem}
  @media(max-width:720px){#guide-search.guide-search{width:100%;margin:0 0 .25rem}#guide-search .guide-search__field{min-height:2.95rem;border-radius:.82rem;box-shadow:none}#guide-search .guide-search__field kbd{display:none}#guide-search .guide-search__results{max-height:48dvh}}
  @media(prefers-contrast:more){#guide-search .guide-search__field{border-width:2px}}
  @media(forced-colors:active){#guide-search .guide-search__field,#guide-search .guide-search__results{border:1px solid CanvasText;box-shadow:none}#guide-search .guide-search__field:focus-within{outline:2px solid Highlight;outline-offset:2px}}
</style>

<script is:inline id="site-runtime">
(() => {
  const d=document,s=d.documentElement;
  s.classList.add("js");
  const clinicHoursNodes=d.querySelectorAll('[data-clinic-open-status]'),clinicFaDigits='۰۱۲۳۴۵۶۷۸۹',clinicAscii=(value)=>String(value||'').replace(/[۰-۹]/g,(digit)=>String(clinicFaDigits.indexOf(digit))),clinicWeekday=new Intl.DateTimeFormat('en-US',{timeZone:'Asia/Tehran',weekday:'short'}),clinicClock=new Intl.DateTimeFormat('en-GB',{timeZone:'Asia/Tehran',hour:'2-digit',minute:'2-digit',hourCycle:'h23'}),syncClinicHours=()=>{const now=new Date(),day=clinicWeekday.format(now),[hour,minute]=clinicClock.format(now).split(':').map(Number),currentMinutes=hour*60+minute;for(const node of clinicHoursNodes){const openFa=node.dataset.open||'',closeFa=node.dataset.close||'',openMinutes=Number(clinicAscii(openFa))*60,closeMinutes=Number(clinicAscii(closeFa))*60;if(!Number.isFinite(openMinutes)||!Number.isFinite(closeMinutes))continue;const isFriday=day==='Fri',isOpen=!isFriday&&currentMinutes>=openMinutes&&currentMinutes<closeMinutes,label=node.querySelector('[data-clinic-open-status-label]'),detail=node.querySelector('[data-clinic-open-status-detail]');node.dataset.state=isOpen?'open':'closed';if(label)label.textContent=isOpen?'اکنون باز است':'اکنون بسته است';if(!detail)continue;if(isOpen)detail.textContent=`تا ساعت ${closeFa}`;else if(isFriday||(day==='Thu'&&currentMinutes>=closeMinutes))detail.textContent=`بازگشایی شنبه ${openFa}`;else if(currentMinutes<openMinutes)detail.textContent=`امروز از ${openFa}`;else detail.textContent=`فردا از ${openFa}`}};
  if(clinicHoursNodes.length){syncClinicHours();setInterval(syncClinicHours,60000)}
  const norm=(v)=>(v||"").toLocaleLowerCase("fa").replace(/[يى]/g,"ی").replace(/ك/g,"ک").replace(/[\u200c\u200f\u200e]/g," ").replace(/[^\p{L}\p{N}\s-]/gu," ").replace(/\s+/g," ").trim(),
    search=d.getElementById("guide-search"),input=d.getElementById("guide-search-input"),results=d.getElementById("guide-search-results"),status=d.getElementById("guide-search-status"),launcher=d.querySelector("[data-guide-search-open]"),top=d.querySelector("[data-quick-actions-top]"),
    plainClick=(e)=>e.button===0&&!e.metaKey&&!e.ctrlKey&&!e.altKey&&!e.shiftKey,
    targetFromHash=(hash)=>{if(!hash)return null;let id;try{id=decodeURIComponent(hash.slice(1))}catch{id=hash.slice(1)}return d.getElementById(id)};
  const searchReady=Boolean(search&&input&&results&&status&&launcher);
  if(searchReady){launcher.replaceWith(search);search.dataset.mounted="true"}

  const aliases=(search?.dataset.entityAliases||"").split("|").map(norm).filter((x)=>x.length>2).sort((a,b)=>b.length-a.length),
    intentTargets=JSON.parse(search?.dataset.intentTargets||"{}"),
    stop=new Set(["از","با","به","برای","در","روی","و","یا","چه","چطور","چگونه","آیا","بهترین","دکتر","پزشک","متخصص","کلینیک","خوب","کرمانشاه","کرماشان","ایران"]),
    alt={بوتاکس:"بوتولینوم",بوتولینوم:"بوتاکس",فیلر:"ژل",ژل:"فیلر",پتوز:"افتادگی",افتادگی:"پتوز",اصلاح:"ترمیم",ترمیم:"اصلاح"},
    tokenMatch=(key,t)=>[t,alt[t]].filter(Boolean).some((v)=>key.includes(v)),
    detectIntent=(text,entity)=>{const has=(x)=>text.includes(x),select=entity||/(بهترین|دکتر|پزشک|متخصص|کلینیک)/u.test(text);if((has("میگرن")||has("سردرد"))&&has("بوتاکس"))return"migraine-botox";if(has("نظر دوم")||has("نظر پزشکی دوم"))return"second-opinion";if(/اورفیل|بیش از حد فیلر|صورت پر شده|پرونده پیچیده/u.test(text))return"complex-correction";if(/اصلاح|ترمیم|نتیجه نامطلوب/u.test(text))return"revision";if(!select)return null;if(/فیلر|ژل/u.test(text))return"filler";if(/بوتاکس|بوتولینوم/u.test(text))return"botox";if(/زیبایی|جوانسازی|جوان سازی/u.test(text))return"aesthetic-physician";return null},
    queryInfo=(value)=>{const original=norm(value);let reduced=original,entity=false;for(const a of aliases)if(reduced.includes(a)){reduced=reduced.replaceAll(a," ");entity=true}reduced=norm(reduced);const raw=reduced.split(" ").filter(Boolean),filtered=raw.filter((t)=>t.length>1&&!stop.has(t));return{original,phrase:reduced||original,tokens:filtered.length?filtered:raw,entity,entityOnly:entity&&!raw.length,intent:detectIntent(original,entity)}};

  let index;
  const build=()=>{if(index)return index;const stack=[];return(index=[...d.querySelectorAll("main h1[id],main h2[id],main h3[id],main h4[id],main h5[id]")].map((h)=>{const text=h.textContent.trim(),level=Number(h.tagName.slice(1)),parents=[];for(let l=1;l<level;l++)if(stack[l])parents.push(stack[l]);stack[level]=text;stack.length=level+1;const answer=h.nextElementSibling?.matches(".answer-projection[id]")?h.nextElementSibling.id:"",titleKey=norm(text+" "+(h.dataset.retrievalAlias||"")),contextKey=norm(parents.join(" "));return{id:h.id,text,level,parents,answer,titleKey,contextKey}}))},
    score=(x,q)=>{if(q.entityOnly)return x.level===1?0:99;if(!q.tokens.length)return 99;let rank=x.level*2,target=q.intent&&intentTargets[q.intent],intentTarget=Boolean(target&&x.answer===target);if(intentTarget)rank-=80;if(x.titleKey===q.phrase)rank-=100;else if(x.titleKey.startsWith(q.phrase))rank-=80;else if(q.phrase.length>2&&x.titleKey.includes(q.phrase))rank-=60;let title=0,context=0;for(const t of q.tokens)tokenMatch(x.titleKey,t)?title++:tokenMatch(x.contextKey,t)&&context++;const matched=title+context,coverage=matched/q.tokens.length;if(!matched||(q.tokens.length>1&&coverage<.5))return intentTarget?35+x.level:99;return rank+Math.round((1-coverage)*80)-title*20-context*6-(q.entity?3:0)},
    closeResults=()=>{results.hidden=true},
    render=()=>{const q=queryInfo(input.value);results.replaceChildren();if(q.original.length<2){closeResults();status.textContent="برای جست‌وجوی دقیق‌تر دست‌کم دو حرف وارد کنید.";return}const hits=build().map((x)=>({...x,rank:score(x,q)})).filter((x)=>x.rank<99).sort((a,b)=>a.rank-b.rank||a.level-b.level||a.text.length-b.text.length).slice(0,16),target=q.intent&&intentTargets[q.intent];if(!hits.length){const li=d.createElement("li");li.className="guide-search__empty";li.textContent="نتیجه‌ای پیدا نشد؛ عبارت کوتاه‌تر یا اصطلاح نزدیک‌تری را امتحان کنید.";results.append(li)}else for(const hit of hits){const li=d.createElement("li"),a=d.createElement("a"),title=d.createElement("span"),context=d.createElement("span");a.href="#"+(target&&hit.answer===target?target:hit.id);title.className="guide-search__result-title";title.textContent=hit.text;a.append(title);const path=hit.parents.slice(-2).join(" ← ");if(path){context.className="guide-search__result-context";context.textContent=path;a.append(context)}li.append(a);results.append(li)}results.hidden=false;status.textContent=hits.length?`${hits.length} نتیجه مرتبط پیدا شد.`:"نتیجه‌ای پیدا نشد."};

  if(searchReady){input.addEventListener("input",render);input.addEventListener("focus",()=>{if(norm(input.value).length>=2)render()});input.addEventListener("keydown",(e)=>{if(e.key==="Escape"){input.value="";closeResults();status.textContent="جست‌وجو پاک شد."}});results.addEventListener("click",(e)=>{if(!plainClick(e)||e.defaultPrevented)return;const link=e.target.closest?.('a[href^="#"]');if(!link||!results.contains(link))return;const target=targetFromHash(link.hash),restore=target&&!target.hasAttribute("tabindex");closeResults();if(!target)return;if(restore)target.tabIndex=-1;requestAnimationFrame(()=>target.focus({preventScroll:true}));if(restore)target.addEventListener("blur",()=>target.removeAttribute("tabindex"),{once:true})});d.addEventListener("pointerdown",(e)=>{if(!search.contains(e.target))closeResults()})}
  d.addEventListener("keydown",(e)=>{if(e.key==="/"&&searchReady&&!e.defaultPrevented&&!e.metaKey&&!e.ctrlKey&&!e.altKey&&!/^(INPUT|TEXTAREA|SELECT)$/.test(d.activeElement?.tagName)&&!d.activeElement?.isContentEditable){e.preventDefault();input.focus({preventScroll:true});input.select()}});
  let topFrame = 0,
    topHideTimer,
    topVisible;
  const setTopVisible = (visible) => {
      if (!top || visible === topVisible) return;
      topVisible = visible;
      clearTimeout(topHideTimer);
      if (visible) {
        top.hidden = false;
        top.removeAttribute("aria-hidden");
        top.removeAttribute("tabindex");
        requestAnimationFrame(() => {
          if (topVisible) top.dataset.visible = "true";
        });
        return;
      }
      top.dataset.visible = "false";
      top.setAttribute("aria-hidden", "true");
      top.tabIndex = -1;
      topHideTimer = setTimeout(() => {
        if (!topVisible) top.hidden = true;
      }, 180);
    },
    syncTop = () => {
      if (topFrame) return;
      topFrame = requestAnimationFrame(() => {
        topFrame = 0;
        setTopVisible(scrollY > Math.max(960, innerHeight * 1.2));
      });
    };
  addEventListener("scroll", syncTop, { passive: true });
  addEventListener("resize", syncTop, { passive: true });
  addEventListener("pageshow", syncTop);

  let tocLinks, targetChunk, currentTocLink;
  const syncTarget = () => {
    const target = targetFromHash(location.hash),
      chunk = target?.closest(".render-chunk");
    if (targetChunk !== chunk) {
      targetChunk?.classList.remove("is-target-chunk");
      chunk?.classList.add("is-target-chunk");
      targetChunk = chunk;
    }
    const section = target?.closest(".content-section"),
      current =
        target &&
        (tocLinks ??= [
          ...d.querySelectorAll(
            '#aesthetic-medicine-table-of-contents a[href^="#"]',
          ),
        ]).find(
          (link) => link.hash === "#" + (section?.id || target?.id),
        );
    if (currentTocLink !== current) {
      currentTocLink?.removeAttribute("aria-current");
      current?.setAttribute("aria-current", "location");
      currentTocLink = current;
    }
  };
  addEventListener("hashchange", syncTarget, { passive: true });
  addEventListener("pageshow", syncTarget);
  syncTarget();

  const revealPoster = (video) => {
      if (!video.poster && video.dataset.poster)
        video.poster = video.dataset.poster;
    },
    posterVideos = [...d.querySelectorAll("video[data-poster]")];
  if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries)
          if (entry.isIntersecting) {
            revealPoster(entry.target);
            observer.unobserve(entry.target);
          }
      },
      { rootMargin: "600px 0px" },
    );
    for (const video of posterVideos) observer.observe(video);
  } else {
    const idle = window.requestIdleCallback || ((fn) => setTimeout(fn, 1));
    idle(() => posterVideos.forEach(revealPoster));
  }

  const p = new URLSearchParams(location.search),
    slug = p.get("video"),
    seconds = Number(p.get("t"));
  if (slug) {
    const video = d.getElementById("video-saeed-ghezelbash-" + slug);
    if (video) {
      revealPoster(video);
      video.preload = "metadata";
      const seek = () => {
        if (Number.isFinite(seconds) && seconds >= 0)
          video.currentTime = Math.min(
            seconds,
            Number.isFinite(video.duration) ? video.duration : seconds,
          );
        video.closest("figure")?.classList.add("video-deeplink-target");
        video.scrollIntoView({ block: "center" });
        video.focus({ preventScroll: true });
      };
      video.readyState >= 1
        ? seek()
        : video.addEventListener("loadedmetadata", seek, { once: true });
    }
  }
})();
</script>
