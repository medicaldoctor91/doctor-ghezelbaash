---
import release from '../data/release.json';
const entityAliases=[...release.primaryEntity.officialAliases,...(release.primaryEntity.reconciliationAliases||[]),...release.primaryEntity.retrievalVariants].join('|');
---
<dialog aria-labelledby="guide-search-title" class="guide-search" data-entity-aliases={entityAliases} id="guide-search">
  <form action="/" class="guide-search__panel" id="guide-search-form" toolautosubmit="" toolname="search_saeed_ghezelbash_guide" tooldescription="Searches the headings of Dr. Saeed Ghezelbash's single-page aesthetic medicine guide in Kermanshah and returns exact section anchors for treatments, complications, diagnostic topics, and physician or clinic information.">
    <header class="guide-search__header">
      <div><p class="guide-search__eyebrow">راهنمای یک‌صفحه‌ای</p><h2 id="guide-search-title">جست‌وجوی سریع در محتوای پزشکی زیبایی</h2></div>
      <button aria-label="بستن جست‌وجو" class="guide-search__close" data-guide-search-close type="button">×</button>
    </header>
    <label class="guide-search__field" for="guide-search-input"><span>نام درمان، عارضه یا سؤال را بنویسید</span><input autocomplete="off" enterkeyhint="search" id="guide-search-input" inputmode="search" name="query" placeholder="مثلاً فیلر زیر چشم، افتادگی پلک یا عارضه بوتاکس" required toolparamdescription="Persian medical or aesthetic search query, or a Saeed Ghezelbash physician/entity alias." type="search" /></label>
    <p aria-live="polite" class="guide-search__status" id="guide-search-status">عنوان‌های H2 تا H4 همین صفحه جست‌وجو می‌شوند. کلید / نیز جست‌وجو را باز می‌کند.</p>
    <ol class="guide-search__results" id="guide-search-results"></ol>
    <noscript><p>برای جست‌وجوی درون‌صفحه‌ای از قابلیت Find مرورگر استفاده کنید. فهرست مطالب کامل بدون جاوااسکریپت در صفحه فعال است.</p></noscript>
  </form>
</dialog>
<script is:inline id="site-runtime">
(()=>{const d=document,s=d.documentElement;s.classList.add('js');const norm=v=>(v||'').toLocaleLowerCase('fa').replace(/[يى]/g,'ی').replace(/ك/g,'ک').replace(/[\u200c\u200f\u200e]/g,' ').replace(/[^\p{L}\p{N}\s-]/gu,' ').replace(/\s+/g,' ').trim(),dialog=d.getElementById('guide-search'),form=d.getElementById('guide-search-form'),input=d.getElementById('guide-search-input'),results=d.getElementById('guide-search-results'),status=d.getElementById('guide-search-status');let index;const aliasKeys=(dialog?.dataset.entityAliases||'').split('|').map(norm).filter(Boolean),build=()=>index??=[...d.querySelectorAll('main h2[id],main h3[id],main h4[id]')].filter(x=>!x.closest('.guide-search')).map(x=>{const text=x.textContent.trim(),headingAlias=x.dataset.retrievalAlias||'',level=Number(x.tagName.slice(1)),entity=/سعید\s*قزلباش|Saeed\s+Ghezelbash/i.test(text+' '+headingAlias);return{id:x.id,text,level,key:norm(text+' '+headingAlias)+(entity?' '+aliasKeys.join(' '):'')}});const score=(x,q)=>{const key=x.key,base=key===q?0:key.startsWith(q)?1:key.split(' ').some(t=>t.startsWith(q))?2:key.includes(q)?3:99;return base===99?99:base*10+x.level},search=v=>{const query=String(v||'').trim(),q=norm(query),hits=q.length<2?[]:build().map(x=>({...x,rank:score(x,q)})).filter(x=>x.rank<99).sort((a,b)=>a.rank-b.rank||a.text.length-b.text.length).slice(0,24);return{query,q,hits}},toolResult=x=>({query:x.query,count:x.hits.length,results:x.hits.map(hit=>{const u=new URL(location.pathname,location.origin);u.hash=hit.id;return{title:hit.text,id:hit.id,headingLevel:hit.level,hash:'#'+hit.id,url:u.href}})}),render=(x=search(input.value))=>{results.replaceChildren();if(x.q.length<2){status.textContent='برای جست‌وجوی دقیق‌تر دست‌کم دو حرف وارد کنید.';return x}for(const hit of x.hits){const li=d.createElement('li'),a=d.createElement('a');a.href='#'+hit.id;a.textContent=hit.text;a.addEventListener('click',()=>dialog.close(),{once:true});li.append(a);results.append(li)}status.textContent=x.hits.length?`${x.hits.length} نتیجه از عنوان‌های صفحه پیدا شد.`:'نتیجه‌ای پیدا نشد؛ واژه کوتاه‌تر یا مترادف را امتحان کنید.';return x};const open=()=>{if(!dialog.open)dialog.showModal();requestAnimationFrame(()=>input.focus())};d.addEventListener('click',e=>{if(e.target.closest('[data-guide-search-open]'))open();if(e.target.closest('[data-guide-search-close]'))dialog.close()});d.addEventListener('keydown',e=>{if(e.key==='/'&&!e.metaKey&&!e.ctrlKey&&!e.altKey&&!/^(INPUT|TEXTAREA|SELECT)$/.test(d.activeElement?.tagName)&&!d.activeElement?.isContentEditable){e.preventDefault();open()}});input?.addEventListener('input',()=>render());form?.addEventListener('submit',e=>{e.preventDefault();const x=render(search(input.value));if(e.agentInvoked&&typeof e.respondWith==='function')e.respondWith(Promise.resolve(toolResult(x)))});addEventListener('toolactivated',e=>{if(e.toolName===form?.getAttribute('toolname')){if(!dialog.open)dialog.showModal();render();requestAnimationFrame(()=>input.focus())}});dialog?.addEventListener('click',e=>{if(e.target===dialog)dialog.close()});const syncTarget=()=>{d.querySelector('.render-chunk.is-target-chunk')?.classList.remove('is-target-chunk');if(!location.hash)return;let id;try{id=decodeURIComponent(location.hash.slice(1))}catch{id=location.hash.slice(1)}d.getElementById(id)?.closest('.render-chunk')?.classList.add('is-target-chunk')};addEventListener('hashchange',syncTarget,{passive:true});syncTarget();const revealPoster=video=>{if(!video.poster&&video.dataset.poster)video.poster=video.dataset.poster},posterVideos=[...d.querySelectorAll('video[data-poster]')];if('IntersectionObserver'in window){const observer=new IntersectionObserver(entries=>{for(const entry of entries)if(entry.isIntersecting){revealPoster(entry.target);observer.unobserve(entry.target)}},{rootMargin:'600px 0px'});for(const video of posterVideos)observer.observe(video)}else{const idle=window.requestIdleCallback||((fn)=>setTimeout(fn,1));idle(()=>posterVideos.forEach(revealPoster))}const p=new URLSearchParams(location.search),slug=p.get('video'),seconds=Number(p.get('t'));if(slug){const video=d.getElementById('video-saeed-ghezelbash-'+slug);if(video){revealPoster(video);video.preload='metadata';const seek=()=>{if(Number.isFinite(seconds)&&seconds>=0)video.currentTime=Math.min(seconds,Number.isFinite(video.duration)?video.duration:seconds);video.closest('figure')?.classList.add('video-deeplink-target');video.scrollIntoView({block:'center'});video.focus({preventScroll:true})};video.readyState>=1?seek():video.addEventListener('loadedmetadata',seek,{once:true})}}})();
</script>