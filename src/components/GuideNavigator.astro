---
import release from '../data/release.json';
const entityAliases=[...release.primaryEntity.officialAliases,...(release.primaryEntity.reconciliationAliases||[]),...release.primaryEntity.retrievalVariants].join('|');
---
<dialog aria-labelledby="guide-search-title" aria-modal="true" class="guide-search" data-entity-aliases={entityAliases} id="guide-search">
  <div aria-label="جست‌وجوی درون راهنمای پزشکی زیبایی" class="guide-search__panel" role="search">
    <header class="guide-search__header">
      <div><p class="guide-search__eyebrow">راهنمای یک‌صفحه‌ای</p><h2 id="guide-search-title">جست‌وجوی سریع در محتوای پزشکی زیبایی</h2></div>
      <button aria-label="بستن جست‌وجو" class="guide-search__close" data-guide-search-close type="button">×</button>
    </header>
    <label class="guide-search__field" for="guide-search-input"><span>نام درمان، عارضه یا سؤال را بنویسید</span><input aria-describedby="guide-search-status" autocomplete="off" enterkeyhint="search" id="guide-search-input" inputmode="search" placeholder="مثلاً فیلر زیر چشم، افتادگی پلک یا عارضه بوتاکس" type="search" /></label>
    <p aria-live="polite" class="guide-search__status" id="guide-search-status">عنوان‌های H2 تا H4 همین صفحه جست‌وجو می‌شوند. کلید / نیز جست‌وجو را باز می‌کند.</p>
    <ol aria-label="نتایج جست‌وجوی عنوان‌های همین صفحه" class="guide-search__results" id="guide-search-results"></ol>
    <noscript><p>برای جست‌وجوی درون‌صفحه‌ای از قابلیت Find مرورگر استفاده کنید. فهرست مطالب کامل بدون جاوااسکریپت در صفحه فعال است.</p></noscript>
  </div>
</dialog>
<script is:inline id="site-runtime">
(()=>{const d=document,s=d.documentElement;s.classList.add('js');const norm=v=>(v||'').toLocaleLowerCase('fa').replace(/[يى]/g,'ی').replace(/ك/g,'ک').replace(/[\u200c\u200f\u200e]/g,' ').replace(/[^\p{L}\p{N}\s-]/gu,' ').replace(/\s+/g,' ').trim(),dialog=d.getElementById('guide-search'),input=d.getElementById('guide-search-input'),results=d.getElementById('guide-search-results'),status=d.getElementById('guide-search-status'),top=d.querySelector('[data-quick-actions-top]');let index;const aliasKeys=(dialog?.dataset.entityAliases||'').split('|').map(norm).filter(Boolean),build=()=>index??=[...d.querySelectorAll('main h2[id],main h3[id],main h4[id]')].filter(x=>!x.closest('.guide-search')).map(x=>{const text=x.textContent.trim(),headingAlias=x.dataset.retrievalAlias||'',level=Number(x.tagName.slice(1)),entity=/سعید\s*قزلباش|Saeed\s+Ghezelbash/i.test(text+' '+headingAlias);return{id:x.id,text,level,key:norm(text+' '+headingAlias)+(entity?' '+aliasKeys.join(' '):'')}});const score=(x,q)=>{const key=x.key,base=key===q?0:key.startsWith(q)?1:key.split(' ').some(t=>t.startsWith(q))?2:key.includes(q)?3:99;return base===99?99:base*10+x.level};const render=()=>{const q=norm(input.value);results.replaceChildren();if(q.length<2){status.textContent='برای جست‌وجوی دقیق‌تر دست‌کم دو حرف وارد کنید.';return}const hits=build().map(x=>({...x,rank:score(x,q)})).filter(x=>x.rank<99).sort((a,b)=>a.rank-b.rank||a.text.length-b.text.length).slice(0,24);for(const hit of hits){const li=d.createElement('li'),a=d.createElement('a');a.href='#'+hit.id;a.textContent=hit.text;a.addEventListener('click',()=>dialog.close(),{once:true});li.append(a);results.append(li)}status.textContent=hits.length?`${hits.length} نتیجه از عنوان‌های صفحه پیدا شد.`:'نتیجه‌ای پیدا نشد؛ واژه کوتاه‌تر یا مترادف را امتحان کنید.'};const open=()=>{if(!dialog.open)dialog.showModal();requestAnimationFrame(()=>input.focus())};d.addEventListener('click',e=>{if(e.target.closest('[data-guide-search-open]'))open();if(e.target.closest('[data-guide-search-close]'))dialog.close()});d.addEventListener('keydown',e=>{if(e.key==='/'&&!e.metaKey&&!e.ctrlKey&&!e.altKey&&!/^(INPUT|TEXTAREA|SELECT)$/.test(d.activeElement?.tagName)&&!d.activeElement?.isContentEditable){e.preventDefault();open()}});input?.addEventListener('input',render);dialog?.addEventListener('click',e=>{if(e.target===dialog)dialog.close()});const syncTop=()=>{if(top)top.hidden=scrollY<800};addEventListener('scroll',syncTop,{passive:true});addEventListener('load',syncTop,{once:true});const tocLinks=[...d.querySelectorAll('#aesthetic-medicine-table-of-contents a[href^=\"#\"]')],syncTarget=()=>{d.querySelector('.render-chunk.is-target-chunk')?.classList.remove('is-target-chunk');for(const link of tocLinks)link.removeAttribute('aria-current');if(!location.hash)return;let id;try{id=decodeURIComponent(location.hash.slice(1))}catch{id=location.hash.slice(1)}const target=d.getElementById(id);target?.closest('.render-chunk')?.classList.add('is-target-chunk');const section=target?.closest('.content-section'),current=tocLinks.find(link=>link.hash==='#'+(section?.id||target?.id));current?.setAttribute('aria-current','location')};addEventListener('hashchange',syncTarget,{passive:true});syncTarget();const revealPoster=video=>{if(!video.poster&&video.dataset.poster)video.poster=video.dataset.poster},posterVideos=[...d.querySelectorAll('video[data-poster]')];if('IntersectionObserver'in window){const observer=new IntersectionObserver(entries=>{for(const entry of entries)if(entry.isIntersecting){revealPoster(entry.target);observer.unobserve(entry.target)}},{rootMargin:'600px 0px'});for(const video of posterVideos)observer.observe(video)}else{const idle=window.requestIdleCallback||((fn)=>setTimeout(fn,1));idle(()=>posterVideos.forEach(revealPoster))}const p=new URLSearchParams(location.search),slug=p.get('video'),seconds=Number(p.get('t'));if(slug){const video=d.getElementById('video-saeed-ghezelbash-'+slug);if(video){revealPoster(video);video.preload='metadata';const seek=()=>{if(Number.isFinite(seconds)&&seconds>=0)video.currentTime=Math.min(seconds,Number.isFinite(video.duration)?video.duration:seconds);video.closest('figure')?.classList.add('video-deeplink-target');video.scrollIntoView({block:'center'});video.focus({preventScroll:true})};video.readyState>=1?seek():video.addEventListener('loadedmetadata',seek,{once:true})}}})();
</script>
