---
const phone = 'tel:+989308209494';
const directChat = 'https://ig.me/m/doctor.ghezelbaash';
const maps = 'https://www.google.com/maps?cid=12350483144643112463';
---

<nav class="quick-actions" aria-label="دسترسی سریع به دکتر سعید قزلباش و کلینیک">
  <a
    class="quick-actions__top"
    href="#main-content"
    aria-label="بازگشت به ابتدای صفحه"
    title="بالای صفحه"
  >
    <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false">
      <path d="M12 19V5m0 0-6 6m6-6 6 6" />
    </svg>
  </a>

  <div class="quick-actions__bar">
    <a
      class="quick-actions__item quick-actions__item--chat"
      href={directChat}
      rel="external"
      aria-label="چت مستقیم با دکتر سعید قزلباش"
      title="چت مستقیم با دکتر سعید قزلباش"
    >
      <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false">
        <path d="M21 12a8 8 0 0 1-8 8H8l-5 2 1.7-4.2A8 8 0 1 1 21 12Z" />
      </svg>
      <span>چت دکتر</span>
    </a>

    <span class="quick-actions__separator" aria-hidden="true"></span>

    <a
      class="quick-actions__item"
      href={phone}
      aria-label="تماس با دکتر سعید قزلباش"
      title="تماس"
    >
      <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false">
        <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.4 19.4 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.8a2 2 0 0 1-.4 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7A2 2 0 0 1 22 16.9Z" />
      </svg>
      <span>تماس</span>
    </a>

    <span class="quick-actions__separator" aria-hidden="true"></span>

    <a
      class="quick-actions__item"
      href={maps}
      rel="external"
      aria-label="مسیریابی کلینیک دکتر سعید قزلباش در کرمانشاه"
      title="مسیر کلینیک"
    >
      <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false">
        <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Zm-8 3a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" />
      </svg>
      <span>مسیر</span>
    </a>
  </div>
</nav>

<style>
  .quick-actions {
    position: fixed;
    z-index: 1000;
    left: 50%;
    bottom: max(0.7rem, calc(env(safe-area-inset-bottom) + 0.3rem));
    width: min(calc(100% - 1.1rem), 27rem);
    margin: 0;
    transform: translateX(-50%);
    pointer-events: none;
  }

  .quick-actions__bar {
    display: grid;
    grid-template-columns: 1.15fr 1px 1fr 1px 1fr;
    align-items: center;
    min-height: 3.25rem;
    padding: 0.28rem 0.34rem;
    border: 1px solid rgb(24 33 30 / 0.08);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.88);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.92) inset,
      0 10px 28px rgb(17 39 31 / 0.12);
    pointer-events: auto;
    -webkit-backdrop-filter: blur(16px) saturate(1.25);
    backdrop-filter: blur(16px) saturate(1.25);
  }

  .quick-actions__item {
    display: inline-flex;
    gap: 0.38rem;
    align-items: center;
    justify-content: center;
    min-width: 0;
    min-height: 2.65rem;
    padding: 0.35rem 0.45rem;
    border-radius: 999px;
    color: #29483f;
    font-size: 0.8rem;
    font-weight: 720;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    -webkit-tap-highlight-color: transparent;
    transition: background-color 140ms ease, color 140ms ease, transform 140ms ease;
  }

  .quick-actions__item:hover {
    transform: translateY(-1px);
    background: rgb(10 107 88 / 0.055);
    color: #075244;
  }

  .quick-actions__item:active {
    transform: scale(0.985);
  }

  .quick-actions__item--chat {
    background: rgb(10 107 88 / 0.06);
    color: #173f35;
  }

  .quick-actions__item svg,
  .quick-actions__top svg {
    width: 1.08rem;
    height: 1.08rem;
    flex: 0 0 auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .quick-actions__separator {
    width: 1px;
    height: 1rem;
    justify-self: center;
    background: rgb(24 33 30 / 0.1);
  }

  .quick-actions__top {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 0.42rem);
    display: grid;
    place-items: center;
    width: 2.15rem;
    height: 2.15rem;
    border: 1px solid rgb(24 33 30 / 0.08);
    border-radius: 999px;
    background: rgb(255 255 255 / 0.9);
    color: #315148;
    box-shadow: 0 6px 18px rgb(17 39 31 / 0.1);
    transform: translateX(-50%);
    text-decoration: none;
    pointer-events: auto;
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    transition: background-color 140ms ease, color 140ms ease, transform 140ms ease;
  }

  .quick-actions__top:hover {
    transform: translateX(-50%) translateY(-1px);
    background: #fff;
    color: #075244;
  }

  @media (max-width: 420px) {
    .quick-actions {
      left: max(0.45rem, env(safe-area-inset-left));
      right: max(0.45rem, env(safe-area-inset-right));
      width: auto;
      transform: none;
    }

    .quick-actions__bar {
      min-height: 3.1rem;
      padding: 0.25rem 0.28rem;
    }

    .quick-actions__item {
      gap: 0.3rem;
      min-height: 2.55rem;
      padding: 0.32rem 0.3rem;
      font-size: 0.74rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .quick-actions__item,
    .quick-actions__top {
      transition: none;
    }
  }

  @media print {
    .quick-actions {
      display: none !important;
    }
  }
</style>
