---
import { canonicalLifecycle as release, canonicalGraph } from '../lib/canonical-inputs.mjs';
import { quickActions as copy } from '../config/site-policy.mjs';
import { deriveSiteData } from '../lib/site-data.mjs';

const site = deriveSiteData(release, canonicalGraph);
---

<nav
  aria-label={copy.ariaLabel}
  class="quick-actions"
>
  <a
    aria-label={copy.top.ariaLabel}
    class="quick-actions__top"
    data-quick-actions-top
    hidden
    href="/"
    title={copy.top.title}
  >
    <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24">
      <path d="M12 19V5m0 0-6 6m6-6 6 6"></path>
    </svg>
  </a>
  <div class="quick-actions__bar">
    <a
      aria-label={copy.phone.ariaLabel}
      class="quick-actions__item quick-actions__item--phone"
      href={site.telHref}
      title={copy.phone.title}
    >
      <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24">
        <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.4 19.4 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.8a2 2 0 0 1-.4 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7A2 2 0 0 1 22 16.9Z"></path>
      </svg>
      <span>{copy.phone.label}</span>
    </a>
    <a
      aria-label={copy.chat.ariaLabel}
      class="quick-actions__item quick-actions__item--consultation"
      href={site.chatUrl}
      rel="external"
      title={copy.chat.title}
    >
      <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24">
        <path d="M21 12a8 8 0 0 1-8 8H8l-5 2 1.7-4.2A8 8 0 1 1 21 12Z"></path>
      </svg>
      <span class="quick-actions__consultation-copy">
        <strong>{copy.chat.label}</strong>
      </span>
    </a>
    <a
      aria-label={copy.directions.ariaLabel}
      class="quick-actions__item quick-actions__item--address"
      href={site.directionsUrl}
      rel="external"
      title={copy.directions.title}
    >
      <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24">
        <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Zm-8 3a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"></path>
      </svg>
      <span>{copy.directions.label}</span>
    </a>
  </div>
</nav>
