---
const phone = 'tel:+989308209494';
const onlineConsultation = 'https://ig.me/m/doctor.ghezelbaash';
const maps = 'https://www.google.com/maps/dir/?api=1&destination=%D9%85%D8%B7%D8%A8%20%D8%AF%DA%A9%D8%AA%D8%B1%20%D8%B3%D8%B9%DB%8C%D8%AF%20%D9%82%D8%B2%D9%84%D8%A8%D8%A7%D8%B4%20%DA%A9%D8%B1%D9%85%D8%A7%D9%86%D8%B4%D8%A7%D9%87&destination_place_id=ChIJBTOYDOTt-j8RD-7mAPy6Zas';
---

<nav class="quick-actions" aria-label="دسترسی سریع به دکتر سعید قزلباش و مطب">
  <a
    class="quick-actions__top"
    href="#main-content"
    aria-label="بازگشت به ابتدای صفحه"
    title="بالای صفحه"
  >
    <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false">
      <path d="M12 19V5m0 0-6 6m6-6 6 6" />
    </svg>
  </a>

  <div class="quick-actions__bar">
    <a
      class="quick-actions__item quick-actions__item--phone"
      href={phone}
      aria-label="تماس با مطب دکتر سعید قزلباش"
      title="تماس با مطب"
    >
      <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false">
        <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.4 19.4 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.8a2 2 0 0 1-.4 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7A2 2 0 0 1 22 16.9Z" />
      </svg>
      <span>تماس</span>
    </a>

    <span class="quick-actions__separator" aria-hidden="true"></span>

    <a
      class="quick-actions__item quick-actions__item--consultation"
      href={onlineConsultation}
      rel="external"
      aria-label="مشاوره آنلاین با دکتر سعید قزلباش"
      title="مشاوره آنلاین با دکتر قزلباش"
    >
      <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false">
        <path d="M21 12a8 8 0 0 1-8 8H8l-5 2 1.7-4.2A8 8 0 1 1 21 12Z" />
      </svg>
      <span class="quick-actions__consultation-copy">
        <strong>مشاوره آنلاین</strong>
        <small>با دکتر قزلباش</small>
      </span>
    </a>

    <span class="quick-actions__separator" aria-hidden="true"></span>

    <a
      class="quick-actions__item quick-actions__item--address"
      href={maps}
      rel="external"
      aria-label="مسیریابی به مطب دکتر سعید قزلباش در Google Maps"
      title="مسیر مطب"
    >
      <svg aria-hidden="true" viewBox="0 0 24 24" focusable="false">
        <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Zm-8 3a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z" />
      </svg>
      <span>مسیر مطب</span>
    </a>
  </div>
</nav>

<style>
  .quick-actions {
    position: fixed;
    z-index: 1000;
    left: 50%;
    bottom: max(0.7rem, calc(env(safe-area-inset-bottom) + 0.3rem));
    width: min(calc(100% - 1.1rem), 31rem);
    margin: 0;
    transform: translateX(-50%);
    pointer-events: none;
  }

  .quick-actions__bar {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) 1px minmax(0, 1.72fr) 1px minmax(0, 0.92fr);
    align-items: center;
    min-height: 3.45rem;
    padding: 0.28rem 0.34rem;
    border: 1px solid rgb(24 33 30 / 0.08);
    border-radius: 999px;
    background: #fff;
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.92) inset,
      0 10px 28px rgb(17 39 31 / 0.12);
    pointer-events: auto;
  }

  .quick-actions__item {
    display: inline-flex;
    gap: 0.4rem;
    align-items: center;
    justify-content: center;
    min-width: 0;
    min-height: 2.8rem;
    padding: 0.34rem 0.48rem;
    border-radius: 999px;
    color: #29483f;
    font-size: clamp(0.74rem, 0.7rem + 0.14vw, 0.82rem);
    font-weight: 720;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    -webkit-tap-highlight-color: transparent;
    transition: background-color 140ms ease, color 140ms ease, transform 140ms ease;
  }

  .quick-actions__item:hover {
    transform: translateY(-1px);
    background: rgb(10 107 88 / 0.055);
    color: #075244;
  }

  .quick-actions__item:active {
    transform: scale(0.985);
  }

  .quick-actions__item--consultation {
    gap: 0.5rem;
    background: rgb(10 107 88 / 0.065);
    color: #173f35;
  }

  .quick-actions__consultation-copy {
    display: grid;
    gap: 0.1rem;
    min-width: 0;
    text-align: center;
    line-height: 1.05;
  }

  .quick-actions__consultation-copy strong {
    font-size: 1em;
    font-weight: 790;
  }

  .quick-actions__consultation-copy small {
    color: #46665d;
    font-size: 0.84em;
    font-weight: 610;
  }

  .quick-actions__item svg,
  .quick-actions__top svg {
    width: 1.08rem;
    height: 1.08rem;
    flex: 0 0 auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .quick-actions__item--consultation svg {
    width: 1.12rem;
    height: 1.12rem;
  }

  .quick-actions__separator {
    width: 1px;
    height: 1rem;
    justify-self: center;
    background: rgb(24 33 30 / 0.1);
  }

  .quick-actions__top {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 0.42rem);
    display: grid;
    place-items: center;
    width: 2.15rem;
    height: 2.15rem;
    border: 1px solid rgb(24 33 30 / 0.08);
    border-radius: 999px;
    background: #fff;
    color: #315148;
    box-shadow: 0 6px 18px rgb(17 39 31 / 0.1);
    transform: translateX(-50%);
    text-decoration: none;
    pointer-events: auto;
    transition: background-color 140ms ease, color 140ms ease, transform 140ms ease;
  }

  .quick-actions__top::before {
    content: "";
    position: absolute;
    inset: -0.35rem;
    border-radius: inherit;
  }

  .quick-actions__top:hover {
    transform: translateX(-50%) translateY(-1px);
    background: #fff;
    color: #075244;
  }

  @media (max-width: 480px) {
    .quick-actions {
      left: max(0.45rem, env(safe-area-inset-left));
      right: max(0.45rem, env(safe-area-inset-right));
      width: auto;
      transform: none;
    }

    .quick-actions__bar {
      grid-template-columns: minmax(0, 0.76fr) 1px minmax(0, 1.76fr) 1px minmax(0, 0.94fr);
      min-height: 3.35rem;
      padding: 0.24rem 0.26rem;
    }

    .quick-actions__item {
      gap: 0.27rem;
      min-height: 2.7rem;
      padding: 0.3rem 0.26rem;
      font-size: clamp(0.7rem, 2.9vw, 0.76rem);
    }

    .quick-actions__item--consultation {
      gap: 0.34rem;
    }

    .quick-actions__item svg {
      width: 1rem;
      height: 1rem;
    }

    .quick-actions__consultation-copy small {
      font-size: 0.8em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .quick-actions__item,
    .quick-actions__top {
      transition: none;
    }
  }

  @media print {
    .quick-actions {
      display: none !important;
    }
  }
</style>
