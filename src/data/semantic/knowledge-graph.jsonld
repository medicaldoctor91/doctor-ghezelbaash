    {
      "@id": "https://www.ghezelbaash.ir/source-of-truth-assurance-profile-v15-2026-10-03",
      "@type": [
        "CreativeWork",
        "prov:Entity"
      ],
      "name": "Canonical Source-of-Truth assurance profile — v15-max",
      "dateCreated": {
        "@value": "2026-10-03",
        "@type": "http://www.w3.org/2001/XMLSchema#date"
      },
      "about": {
        "@id": "https://www.ghezelbaash.ir/graph.jsonld/dataset"
      },
      "isBasedOn": {
        "@id": "https://www.ghezelbaash.ir/standards-assurance-profile-v14-2026-10-03"
      },
      "description": [
        {
          "@value": "v15-max preserves all authority, evidence, credential, role, publication, reputation and clinical claim topology while making the source-of-truth JSON-LD self-contained. Web Annotation terms remain semantically explicit through the local oa prefix, without claiming strict standalone Web Annotation JSON serialization conformance. The graph adds DCAT 3 release-series/versioning, catalog-record metadata, distribution interoperability, explicit provenance, structured-data provenance metadata, controlled-vocabulary alignment and stronger validation targets.",
          "@language": "en"
        },
        {
          "@value": "v15-max همه توپولوژی اعتبار، شواهد، مدارک، نقش‌ها، انتشارات، شهرت و ادعاهای بالینی را حفظ می‌کند و JSON-LD منبع حقیقت را self-contained نگه می‌دارد. اصطلاحات Web Annotation از طریق پیشوند محلی oa به‌طور معنایی صریح باقی می‌مانند، بدون ادعای انطباق سخت‌گیرانه با serialization مستقل Web Annotation. گراف همچنین نسخه‌بندی و release-series مبتنی بر DCAT 3، رکورد کاتالوگ، interoperability توزیع‌ها، provenance صریح، metadata منشأ structured data، هم‌ترازی واژگان کنترل‌شده و validation قوی‌تر اضافه می‌کند.",
          "@language": "fa"
        }
      ],
      "dcterms:conformsTo": [
        {
          "@id": "https://www.w3.org/TR/json-ld11/"
        },
        {
          "@id": "https://www.w3.org/TR/rdf11-concepts/"
        },
        {
          "@id": "https://www.w3.org/TR/shacl/"
        },
        {
          "@id": "https://www.w3.org/TR/rdf-canon/"
        },
        {
          "@id": "https://schema.org/version/30.1/"
        }
      ],
      "prov:wasAttributedTo": {
        "@id": "https://www.ghezelbaash.ir/saeed-ghezelbash"
      },
      "dcterms:relation": [
        {
          "@id": "https://www.w3.org/TR/annotation-model/"
        },
        {
          "@id": "https://www.w3.org/TR/shacl12-core/"
        },
        {
          "@id": "https://www.w3.org/TR/vocab-dcat-3/"
        },
        {
          "@id": "http://mlcommons.org/croissant/1.1"
        }
      ]
    },
    {
      "@id": "https://www.ghezelbaash.ir/change-note-source-of-truth-v15-2026-10-03",
      "@type": [
        "CreativeWork",
        "prov:Entity"
      ],
      "name": "v15 canonical Source-of-Truth alignment",
      "dateCreated": {
        "@value": "2026-10-03",
        "@type": "http://www.w3.org/2001/XMLSchema#date"
      },
      "about": {
        "@id": "https://www.ghezelbaash.ir/graph.jsonld/dataset"
      },
      "isBasedOn": {
        "@id": "https://www.ghezelbaash.ir/change-note-standards-hardening-v14-2026-10-03"
      },
      "description": "Corrects the v14 Dataset.version lifecycle mismatch (2.1.0 → 1.3.3) while preserving every v14 top-level resource and all authority/evidence relationships. The normative Web Annotation remote context remains intact; the required build-contract upgrade is documented but intentionally not applied to the repository.",
      "prov:wasAttributedTo": {
        "@id": "https://www.ghezelbaash.ir/saeed-ghezelbash"
      }
    },
