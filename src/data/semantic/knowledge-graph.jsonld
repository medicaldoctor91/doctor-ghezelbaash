    {
      "@id": "https://www.ghezelbaash.ir/expertise-evidence-bundle-botulinum-toxin-2026-10-03",
      "@type": [
        "CreativeWork",
        "prov:Collection",
        "https://www.ghezelbaash.ir/ontology/ExpertiseEvidenceBundle"
      ],
      "name": "Expertise evidence convergence — botulinum toxin",
