    {
      "@id": "https://www.ghezelbaash.ir/authority-evidence-hub-2026-10-03",
      "@type": [
        "CreativeWork",
        "prov:Collection",
        "https://www.ghezelbaash.ir/ontology/AuthorityEvidenceHub"
      ],
      "name": [
        {
          "@value": "مرکز شواهد اعتبار، تخصص و شهرت حرفه‌ای دکتر سعید قزلباش",
          "@language": "fa"
        },
        {
          "@value": "Dr. Saeed Ghezelbash Authority, Expertise and Evidence Hub",
          "@language": "en"
        }
      ],
      "description": [
        {
          "@value": "نقطه ورود مرکزی برای مدارک حرفه‌ای، ثبت پزشکی، تخصص‌های بالینی، تجربه و عملکرد بالینی، پژوهش و تألیف، نقش‌ها و دستاوردهای حرفه‌ای، شهرت و بازخورد چندپلتفرمی و منابع بیرونی مرتبط با شخص canonical.",
          "@language": "fa"
        },
        {
          "@value": "Central machine-traversable entry point connecting the canonical physician to credentials, medical registration, clinical expertise, clinical experience/performance, research/authorship, professional roles/achievements, multi-platform reputation observations and external corroboration already present in the graph.",
          "@language": "en"
        },
        {
          "@value": "Version 13 additionally exposes source-to-entity evidence inverses, Web Annotation indexing, cross-source identity/practice convergence, claim-specific provenance bundles, direct authorship/role navigation, structured professional-recognition nodes, and platform-specific/cross-platform reputation evidence collections while preserving unlike metrics separately.",
          "@language": "en"
        }
      ],
      "about": {
        "@id": "https://www.ghezelbaash.ir/saeed-ghezelbash"
