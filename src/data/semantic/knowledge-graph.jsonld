      },
      "hasPart": [
        {
          "@id": "https://www.ghezelbaash.ir/video-jalupro-vs-profhilo-clip-01"
        },
        {
          "@id": "https://www.ghezelbaash.ir/video-jalupro-vs-profhilo-clip-02"
        },
        {
          "@id": "https://www.ghezelbaash.ir/video-jalupro-vs-profhilo-clip-03"
