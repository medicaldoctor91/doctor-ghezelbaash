      "uploadDate": {
        "@value": "2024-12-18T09:58:51.282Z",
        "@type": "http://www.w3.org/2001/XMLSchema#dateTime"
      },
      "description": "توضیحات دکتر سعید قزلباش درباره پروفایلو، جالپرو و تفاوت جوانسازهای تزریقی.",
      "version": "1.2.1",
      "dateModified": {
        "@value": "2026-09-30",
