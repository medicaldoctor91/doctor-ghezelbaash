    {
      "@id": "https://www.ghezelbaash.ir/skin-rejuvenation#question-skin-rejuvenation-doctor-selection-criteria",
      "@type": "Question",
      "name": "بهترین دکتر جوان‌سازی پوست چه کسی است؟",
      "url": "https://www.ghezelbaash.ir/skin-rejuvenation#skin-rejuvenation-doctor-selection-criteria",
      "inLanguage": "fa-IR",
      "acceptedAnswer": {
