        }
      ],
      "thumbnailUrl": "https://www.ghezelbaash.ir/media/posters/education/saeed-ghezelbash-subcision-technique.9cb6520c1ca2.webp",
      "about": [
        {
          "@id": "https://www.ghezelbaash.ir/saeed-ghezelbash"
        },
        {
          "@id": "https://www.ghezelbaash.ir/procedure-subcision"
        }
      ],
      "creator": {
        "@id": "https://www.ghezelbaash.ir/saeed-ghezelbash"
      },
      "publisher": {
        "@id": "https://www.ghezelbaash.ir/saeed-ghezelbash"
      },
      "copyrightHolder": {
        "@id": "https://www.ghezelbaash.ir/saeed-ghezelbash"
      },
      "isPartOf": {
        "@id": "https://www.ghezelbaash.ir/webpage"
      },
      "inLanguage": "fa-IR",
      "duration": "PT36S",
      "url": "https://www.ghezelbaash.ir/subcision-for-tethered-acne-scars",
      "sameAs": "https://www.instagram.com/reel/DE5QDlepCe7/",
      "identifier": "urn:uuid:4a3f0d81-9195-5f87-8156-3c28fa033027",
      "width": {
        "@id": "https://www.ghezelbaash.ir/video-subcision-technique-width"
      },
      "height": {
        "@id": "https://www.ghezelbaash.ir/video-subcision-technique-height"
      },
      "uploadDate": {
        "@value": "2025-01-16T17:17:17.334Z",
        "@type": "http://www.w3.org/2001/XMLSchema#dateTime"
      },
      "description": "توضیحات دکتر سعید قزلباش درباره سابسیژن.",
      "version": "1.2.1",
      "dateModified": {
        "@value": "2026-09-30",
        "@type": "http://www.w3.org/2001/XMLSchema#date"
      },
      "hasPart": [
        {
          "@id": "https://www.ghezelbaash.ir/video-subcision-technique-clip-01"
        },
        {
          "@id": "https://www.ghezelbaash.ir/video-subcision-technique-clip-02"
        },
        {
          "@id": "https://www.ghezelbaash.ir/video-subcision-technique-clip-03"
        },
        {
          "@id": "https://www.ghezelbaash.ir/video-subcision-technique-clip-04"
        }
      ],
      "transcript": "آقای دکتر\nسابسیژن انجام دادید؟\nآره، داریم سابسیژن انجام میدیم.\nراستش من خیلی ایراد میگیرم راجع به سابسیژن\nو خیلی میگن یه جلسه انجام دادیم خوب نشده\nحقیقت اینه که سابسیژن بدون تزریق فیلر معنا نداره\nبی‌تاثیره!!\nولی اکثر مواقع تاثیرش بالعکسه\nباید حتما ما هنگام سابسیژن\nتزریق فیلر مونوفازیک داشته باشیم\nکه اون دو تا بافتی که چسبندگی داشتن\nجدا شدن از هم با سابسیژن ما\nکه یک فاصله یافته جدا جدا بهبود پیدا کنن\nبدون تزریق فیلر\nقطعا قطعا شرایط بیمار بدتر خواهد شد\nسابسیژن اصولی یک جلسه است",
      "caption": "https://www.ghezelbaash.ir/media/video-tracks/education/saeed-ghezelbash-subcision-technique.captions.fa.7f2640c97d71.vtt"
    },
