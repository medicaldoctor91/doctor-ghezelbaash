      },
      "about": {
        "@id": "https://www.ghezelbaash.ir/procedure-botulinum-toxin-aesthetic-treatment"
      }
    },
    {
      "@id": "https://www.ghezelbaash.ir/botox#question-botox-for-nasal-shape-limitations",
