      },
      "isPartOf": {
        "@id": "https://www.ghezelbaash.ir/webpage"
      },
      "about": {
        "@id": "https://www.ghezelbaash.ir/procedure-acne-scar-evaluation"
      }
    },
    {
      "@id": "https://www.ghezelbaash.ir/aesthetic-treatment-selection#question-subcision-acne-scar-candidacy",
      "@type": "Question",
      "name": "سابسیژن برای همه جای جوش‌ها مناسب است؟",
      "url": "https://www.ghezelbaash.ir/aesthetic-treatment-selection#subcision-acne-scar-candidacy",
      "inLanguage": "fa-IR",
      "acceptedAnswer": {
        "@id": "https://www.ghezelbaash.ir/aesthetic-treatment-selection#answer-subcision-acne-scar-candidacy"
      },
      "answerCount": 1,
      "isPartOf": {
