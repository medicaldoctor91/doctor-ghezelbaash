      "rdfs:label": {
        "@value": "Identity evidence convergence bundle",
        "@language": "en"
      },
      "rdfs:comment": {
        "@value": "A collection exposing cross-source identity evidence and Web Annotation links for a canonical entity without treating every source as owl:sameAs or assuming source independence.",
