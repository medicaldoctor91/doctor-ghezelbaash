      "inLanguage": "fa-IR",
      "acceptedAnswer": {
        "@id": "https://www.ghezelbaash.ir/diagnosis-before-aesthetic-treatment-selection#answer-individualized-facial-treatment-planning"
      },
      "answerCount": 1,
      "isPartOf": {
