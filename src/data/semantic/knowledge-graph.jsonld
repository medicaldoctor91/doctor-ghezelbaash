    {
      "@id": "https://www.ghezelbaash.ir/change-note-authority-amplification-v12-2026-10-03",
      "@type": "CreativeWork",
      "name": "Authority amplification topology upgrade — v12 — 2026-10-03",
      "dateCreated": {
        "@value": "2026-10-03",
        "@type": "http://www.w3.org/2001/XMLSchema#date"
      },
      "creator": {
        "@id": "https://www.ghezelbaash.ir/saeed-ghezelbash"
      },
      "about": {
        "@id": "https://www.ghezelbaash.ir/authority-evidence-hub-2026-10-03"
      },
      "description": "Additive topology upgrade: central authority/evidence hubs, direct Person-to-skill knowsAbout links, skill-specific evidence convergence bundles, bidirectional evidence support links, clinical/reputation dataset membership, cross-source corroboration, research/credential/achievement centralization, medical-concept mappings and SHACL constraints. Existing factual nodes are preserved."
    },
    {
      "@id": "https://www.ghezelbaash.ir/ontology/EvidenceConvergenceBundle",
      "@type": "rdfs:Class",
      "rdfs:label": {
        "@value": "Evidence convergence bundle",
        "@language": "en"
      },
      "rdfs:comment": {
        "@value": "A provenance-aware collection that brings together already-existing sources, observations, identifiers or authority-bearing entities supporting or evidencing the same entity or assertion.",
        "@language": "en"
      },
      "rdfs:subClassOf": {
        "@id": "http://www.w3.org/ns/prov#Collection"
      },
      "rdfs:isDefinedBy": {
        "@id": "https://www.ghezelbaash.ir/ontology/knowledge-graph"
      }
    },
