      "@type": "sh:SPARQLConstraint",
      "sh:message": "Entity evidence sources (excluding evidence-tier vocabulary/meta artifacts) MUST identify at least one evidenced entity or explicit about target.",
      "sh:select": "SELECT $this WHERE { $this a <https://www.ghezelbaash.ir/ontology/EvidenceSource> . FILTER(!CONTAINS(STR($this), \"/evidence-tier-\") && STR($this) != \"https://www.ghezelbaash.ir/evidence-assessment-tier-scheme\" && STR($this) != \"https://www.ghezelbaash.ir/evidence-snapshot.json/distribution\") FILTER NOT EXISTS { $this <https://www.ghezelbaash.ir/ontology/evidencesEntity> ?x } FILTER NOT EXISTS { $this <https://schema.org/about> ?x } }"
    },
