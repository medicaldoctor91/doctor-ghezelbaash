ps://www.ghezelbaash.ir/#aesthetic-revision-and-second-opinion"},{"@id":"https://www.ghezelbaash.ir/#aesthetic-medical-consultation"}],"identifier":[{"@id":"https://www.ghezelbaash.ir/#identifier-clinic-google-kgid"},{"@id":"https://www.ghezelbaash.ir/#identifier-clinic-google-place-id"},{"@id":"https://www.ghezelbaash.ir/#identifier-clinic-google-maps-cid"},{"@id":"https://www.ghezelbaash.ir/#identifier-clinic-osm-node"},{"@id":"https://www.ghezelbaash.ir/#identifier-clinic-foursquare"},{"@id":"https://www.ghezelbaash.ir/#identifier-clinic-huggingface"},{"@id":"https://www.ghezelbaash.ir/#identifier-clinic-yandex"},{"@id":"https://www.ghezelbaash.ir/#identifier-clinic-neshan"},{"@id":"https://www.ghezelbaash.ir/#identifier-clinic-balad"},{"@id":"https://www.ghezelbaash.ir/#identifier-clinic-wikidata"}],"sameAs":["https://www.wikidata.org/entity/Q140288589","https://www.google.com/maps?cid=12350483144643112463","https://www.openstreetmap.org/node/13530287096","https://huggingface.co/doctor-ghezelbaash"],"image":[{"@id":"https://www.ghezelbaash.ir/#image-saeed-ghezelbash-clinical-team-master"},{"@id":"https://www.ghezelbaash.ir/#image-saeed-ghezelbash-clinical-office-master"}],"alternateName":["Dr. Saeed Ghezelbash Aesthetic Clinic","Dr. Ghezelbaash Aesthetic Clinic","Dr. Saeed Ghezelbaash Aesthetic Clinic","Dr. Saeed Ghezelbash Clinic"],"description":[{"@value":"کلینیک زیبایی دکتر سعید قزلباش در کرمانشاه؛ کلینیک متعلق به پزشک و محل ارائه مستقیم خدمات پزشکی زیبایی جراحی و غیرجراحی، ارزیابی تشخیصی، درمان‌های تزریقی، پوست و مو، کانتورینگ، اصلاح نتایج قبلی و جراحی‌های زیبایی منتخب. پذیرش حضوری از ایران و عراق و ساعت فعالیت معمول شنبه تا پنج‌شنبه ۱۶ تا ۲۲؛ جمعه تعطیل.","@language":"fa"},{"@value":"Dr. Saeed Ghezelbash Aesthetic Clinic in Kermanshah is the physician-owned location where he personally provides surgical and nonsurgical aesthetic medical services, diagnostic assessment, injectables, skin/hair treatments, contouring, revision care and selected aesthetic surgery. In-person patient catchment includes Iran and Iraq. Regular hours are Saturday–Thursday 16:00–22:00; Friday closed.","@language":"en"}],"geo":{"@id":"https://www.ghezelbaash.ir/#clinic-geo"},"openingHoursSpecification":[{"@id":"https://www.ghezelbaash.ir/#clinic-opening-hours-sat-thu"},{"@id":"https://www.ghezelbaash.ir/#clinic-friday-closed"}],"hasMap":["https://www.google.com/maps?cid=12350483144643112463","https://www.google.com/maps/search/?api=1&query=%DA%A9%D9%84%DB%8C%D9%86%DB%8C%DA%A9%20%D8%B2%DB%8C%D8%A8%D8%A7%DB%8C%DB%8C%20%D8%AF%DA%A9%D8%AA%D8%B1%20%D9%82%D8%B2%D9%84%D8%A8%D8%A7%D8%B4%20%DA%A9%D8%B1%D9%85%D8%A7%D9%86%D8%B4%D8%A7%D9%87&query_place_id=ChIJBTOYDOTt-j8RD-7mAPy6Zas","https://www.openstreetmap.org/node/13530287096","https://balad.ir/p/2dnVakli9ZKaBd","https://yandex.com/maps/org/63459342435/"],"potentialAction":[{"@id":"https://www.ghezelbaash.ir/#action-contact-clinic"},{"@id":"https://www.ghezelbaash.ir/#action-online-initial-consultation"},{"@id":"https://www.ghezelbaash.ir/#action-view-clinic-map"},{"@id":"https://www.ghezelbaash.ir/#action-follow-instagram"}],"medicalSpecialty":{"@id":"https://www.ghezelbaash.ir/#medical-specialty-aesthetic-medicine"},"logo":{"@id":"https://www.ghezelbaash.ir/#image-doctor-ghezelbaash-clinic-logo"},"priceRange":"$$$$"},{"@id":"https://www.ghezelbaash.ir/#saeed-ghezelbash","@type":["Person","IndividualPhysician"],"name":[{"@value":"دکتر سعید قزلباش","@language":"fa"},{"@value":"Saeed Ghezelbash","@language":"en"}],"givenName":[{"@value":"سعید","@language":"fa"},{"@value":"Saeed","@language":"en"}],"familyName":[{"@value":"قزلباش","@language":"fa"},{"@value":"Ghezelbash","@language":"en"}],"alternateName":["Mohammad Saeed Ghezelbash","Dr. Mohammad Saeed Ghezelbash","Mohammad Saeed Ghezelbaash","Dr. Mohammad Saeed Ghezelbaash","Saeed Ghezelbash","Dr. Saeed Ghezelbash","Saeed Ghezelbaash","Dr. Saeed Ghezelbaash","دکتر محمدسعید قزلباش","دکتر محمد سعید قزلباش","محمدسعید قزلباش","محمد سعید قزلباش","دکتر سعید قزلباش","سعید قزلباش","MohammadSaeed Ghezelbash","Mohamadsaeed Ghezelbash","Mohammadssaeed Ghezelbash","Mohammadssaeed Ghezelbaash","Mohammad Saeed Ghazlbash","Dr. Mohammad Saeed Ghazlbash","Doctor Ghezelbaash","Ghezelbash MS"],"jobTitle":[{"@value":"پزشک زیبایی","@language":"fa"},{"@value":"Aesthetic physician","@language":"en"}],"url":"https://www.ghezelbaash.ir/","mainEntityOfPage":{"@id":"https://www.ghezelbaash.ir/#webpage"},"hasCredential":[{"@id":"https://www.ghezelbaash.ir/#credential-doctor-of-medicine"},{"@id":"https://www.ghezelbaash.ir/#irimc-credential-167430"}],"practicesAt":{"@id":"https://www.ghezelbaash.ir/#dr-saeed-ghezelbash-aesthetic-clinic-kermanshah"},"workLocation":[{"@id":"https://www.ghezelbaash.ir/#dr-saeed-ghezelbash-aesthetic-clinic-kermanshah"},{"@id":"https://www.ghezelbaash.ir/#city-kermanshah"}],"owns":[{"@id":"https://www.ghezelbaash.ir/#dr-saeed-ghezelbash-aesthetic-clinic-kermanshah"},{"@id":"https://www.ghezelbaash.ir/#doctor-ghezelbaash-structured-data-project"}],"availableService":[{"@id":"https://www.ghezelbaash.ir/#aesthetic-revision-and-second-opinion"},{"@id":"https://www.ghezelbaash.ir/#free-online-aesthetic-initial-consultation"},{"@id":"https://www.ghezelbaash.ir/#aesthetic-medical-consultation"}],"makesOffer":[{"@id":"https://www.ghezelbaash.ir/#free-online-aesthetic-initial-consultation-offer"},{"@id":"https://www.ghezelbaash.ir/#aesthetic-revision-and-second-opinion-offer"}],"areaServed":[{"@id":"https://www.ghezelbaash.ir/#country-iran"},{"@id":"https://www.ghezelbaash.ir/#country-iraq"}],"image":[{"@id":"https://www.ghezelbaash.ir/#image-saeed-ghezelbash-portrait-master"},{"@id":"https://www.ghezelbaash.ir/#image-saeed-ghezelbash-portrait-square-1200"},{"@id":"https://www.ghezelbaash.ir/#image-saeed-ghezelbash-portrait-4x3-1200"},{"@id":"https://www.ghezelbaash.ir/#image-saeed-ghezelbash-portrait-16x9-1200"}],"identifier":[{"@id":"https://www.ghezelbaash.ir/#identifier-person-google-kgid"},{"@id":"https://www.ghezelbaash.ir/#identifier-person-irimc"},{"@id":"https://www.ghezelbaash.ir/#identifier-person-minc"},{"@id":"https://www.ghezelbaash.ir/#identifier-person-orcid"},{"@id":"https://www.ghezelbaash.ir/#identifier-person-openalex"},{"@id":"https://www.ghezelbaash.ir/#identifier-person-github"},{"@id":"https://www.ghezelbaash.ir/#identifier-person-huggingface"},{"@id":"https://www.ghezelbaash.ir/#identifier-person-instagram"},{"@id":"https://www.ghezelbaash.ir/#identifier-person-linkedin"},{"@id":"https://www.ghezelbaash.ir/#identifier-person-google-scholar"},{"@id":"https://www.ghezelbaash.ir/#identifier-person-wikidata"},{"@id":"https://www.ghezelbaash.ir/#identifier-person-wikimedia-commons-category"},{"@id":"https://www.ghezelbaash.ir/#identifier-person-semantic-scholar"}],"sameAs":["https://www.wikidata.org/entity/Q140287622","https://commons.wikimedia.org/wiki/Category:Saeed_Ghezelbash","https://membersearch.irimc.org/member/profile?id=9efaaf28-52ff-49ad-8d45-be6e48c4fa3e","https://orcid.org/0009-0001-9346-8475","https://www.ncbi.nlm.nih.gov/myncbi/saeed.ghezelbash.1/bibliography/public/","https://openalex.org/A5064828898","https://www.semanticscholar.org/author/-/3786699","https://scholar.google.com/citations?user=BcWBirUAAAAJ","https://github.com/medicaldoctor91","https://huggingface.co/Ghezelbaash","https://www.instagram.com/doctor.ghezelbaash/","https://about.me/ghezelbaash","https://www.facebook.com/Doctor.Ghezelbaash","https://www.facebook.com/Ghezelbaash","https://www.linkedin.com/in/saeed-ghezelbash-93310a96","https://twitter.com/Qezelbaash","https://www.pinterest.com/Qezelbaash","https://www.instagram.com/ghezelbaash/"],"description":[{"@value":"دکتر سعید قزلباش، پزشک دارای دکترای حرفه‌ای پزشکی و شماره نظام پزشکی ۱۶۷۴۳۰ در کرمانشاه، ارائه‌دهنده مستقیم طیف گسترده خدمات پزشکی زیبایی جراحی و غیرجراحی در کلینیک متعلق به خود؛ با تمرکز بر تشخیص پیش از مداخله، انتخاب بیمار، اصلاح نتایج قبلی و نظر دوم، و پذیرش مراجعان از سراسر ایران و عراق. مشاوره آنلاین اولیه رایگان با دسترسی جهانی ارائه می‌شود و اقدامات حضوری در کلینیک کرمانشاه انجام می‌شوند.","@language":"fa"},{"@value":"Dr. Saeed Ghezelbash is an MD and IRIMC-registered aesthetic physician in Kermanshah who personally provides a broad range of surgical and nonsurgical aesthetic medical services at his owned clinic, with an emphasis on diagnosis before intervention, patient selection, revision/second opinion, and in-person care for patients traveling from across Iran and Iraq. Free initial online consultation is available worldwide; in-person procedures are performed in Kermanshah.","@language":"en"}],"disambiguatingDescription":"دکتر محمدسعید (سعید) قزلباش؛ پزشک با شماره نظام پزشکی 167430، صاحب و بنیان‌گذار کلینیک زیبایی دکتر سعید قزلباش در کرمانشاه، ایران.","telephone":"+989308209494","memberOf":[{"@id":"https://www.ghezelbaash.ir/#organization-iran-medical-council"}],"potentialAction":[{"@id":"https://www.ghezelbaash.ir/#action-contact-clinic"},{"@id":"https://www.ghezelbaash.ir/#action-online-initial-consultation"},{"@id":"https://www.ghezelbaash.ir/#action-view-clinic-map"},{"@id":"https://www.ghezelbaash.ir/#action-follow-instagram"}],"hasOccupation":[{"@id":"https://www.ghezelbaash.ir/#occupation-physician"},{"@id":"https://www.ghezelbaash.ir/#occupation-medical-researcher"}],"medicalSpecialty":{"@id":"https://www.ghezelbaash.ir/#medical-specialty-aesthetic-medicine"},"alumniOf":{"@id":"https://www.ghezelbaash.ir/#kermanshah-university-of-medical-sciences"},"honorificPrefix":[{"@value":"دکتر","@language":"fa"},{"@value":"Dr.","@language":"en"}],"knowsLanguage":["fa","en"],"address":{"@id":"https://www.ghezelbaash.ir/#clinic-postal-address"},"priceRange":"$$$$"},{"@id":"https://www.ghezelbaash.ir/#free-online-aesthetic-initial-consultation","@type":"Service","name":[{"@value":"مشاوره آنلاین اولیه رایگان پزشکی زیبایی","@language":"fa"},{"@value":"Free online initial aesthetic consultation","@language":"en"}],"serviceType":"Free online initial aesthetic consultation","prov