{
  "schemaVersion": "2.1",
  "identitySource": "src/data/semantic/knowledge-graph.jsonld",
  "releaseLifecycleSource": "src/data/release.json",
  "resourceRegistry": "src/data/machine-resources.json",
  "retrievalPolicySource": "src/data/retrieval/query-matrix-policy.json",
  "surfaces": {
    "website": {
      "role": "canonical-first-party-dataset",
      "resourceTarget": "website",
      "canonicalRef": "release.canonicalUrl",
      "datasetRef": "graph.dataset"
    },
    "github": {
      "role": "version-controlled-source",
      "repositoryRef": "release.dataset.github.repository"
    },
    "zenodo": {
      "role": "immutable-doi-preservation",
      "resourceTarget": "zenodo",
      "versionDoiRef": "release.dataset.zenodo.versionDoi"
    },
    "huggingFace": {
      "role": "ai-retrieval-distribution",
      "resourceTarget": "huggingFace",
      "retrievalPolicyRef": "src/data/retrieval/query-matrix-policy.json",
      "datasetRef": "release.dataset.huggingFace.dataset",
      "organization": "doctor-ghezelbaash",
      "taskCategories": [
        "question-answering",
        "text-retrieval",
        "text-generation"
      ],
      "viewerPackaging": {
        "schemaVersion": 1,
        "revision": 1,
        "manifestPath": "viewer/packaging.json",
        "builder": "pyarrow",
        "builderVersion": "25.0.1",
        "derivatives": [
          {
            "config": "entity_facts",
            "source": "entity-facts.csv",
            "path": "viewer/entity-facts.parquet"
          },
          {
            "config": "query_matrix",
            "source": "query-matrix.jsonl",
            "path": "viewer/query-matrix.parquet"
          }
        ]
      },
      "configs": [
        {
          "name": "entity_facts",
          "path": "viewer/entity-facts.parquet",
          "default": true
        },
        {
          "name": "query_matrix",
          "path": "viewer/query-matrix.parquet",
          "default": false
        }
      ]
    }
  }
}
