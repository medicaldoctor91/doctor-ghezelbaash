{
  "schemaVersion": "1.0",
  "repository": "medicaldoctor91/doctor-ghezelbaash",
  "canonicalUrl": "https://www.ghezelbaash.ir/",
  "canonicalHost": "www.ghezelbaash.ir",
  "zoneName": "ghezelbaash.ir",
  "runtime": {
    "node": "24.19.0",
    "nodeEngine": ">=24.19.0 <25",
    "npm": "11.9.0",
    "npmEngine": ">=11.9 <12"
  },
  "cloudflare": {
    "accountId": "884d1d90bd1fb6ecca14992c6c60d677",
    "pagesProject": "doctor-ghezelbaash",
    "productionBranch": "main",
    "expectedEnvironment": "production",
    "planTier": "free",
    "requiredCustomDomains": [
      "www.ghezelbaash.ir",
      "blog.ghezelbaash.ir"
    ],
    "build": {
      "command": "npm run build",
      "destinationDir": "dist",
      "rootDir": ""
    },
    "preview": {
      "deploymentSetting": "none",
      "branchIncludes": [],
      "branchExcludes": []
    },
    "delivery": {
      "mode": "static-assets",
      "serverRuntime": "none",
      "dynamicRoutes": [],
      "requiredProductionBindings": []
    }
  },
  "automation": {
    "reputationRefresh": {
      "workflow": ".github/workflows/reputation-refresh.yml",
      "schedule": "23 */6 * * *",
      "sourceFile": "src/data/reputation-observation.json",
      "source": "Google Places API (New)",
      "fieldMask": [
        "id",
        "rating",
        "userRatingCount",
        "businessStatus",
        "movedPlace",
        "movedPlaceId"
      ],
      "requiredGitHubSecrets": [
        "GOOGLE_PLACES_API_KEY"
      ],
      "upstreamCallsPerRun": 1,
      "publishOnChangeOnly": true
    }
  },
  "source": {
    "canonicalContent": "src/content-source/page.md",
    "canonicalStylesheet": "src/styles/global.css",
    "routes": [
      "404.astro",
      "favicon.png.ts",
      "index.astro"
    ],
    "workflows": [
      ".github/workflows/ci.yml",
      ".github/workflows/cloudflare-pages-deploy.yml",
      ".github/workflows/github-pages-bridge.yml",
      ".github/workflows/hugging-face-authority.yml",
      ".github/workflows/reputation-refresh.yml",
      ".github/workflows/stack-monitor.yml"
    ]
  }
}
