ttps://www.ghezelbaash.ir/#evidence-tabibino"},{"@id":"https://www.ghezelbaash.ir/#evidence-drnext"},{"@id":"https://www.ghezelbaash.ir/#evidence-mantradoc"},{"@id":"https://www.ghezelbaash.ir/#evidence-icliniq"},{"@id":"https://www.ghezelbaash.ir/#evidence-doctor-yab"},{"@id":"https://www.ghezelbaash.ir/#evidence-niniban"},{"@id":"https://www.ghezelbaash.ir/#evidence-khabaronline"},{"@id":"https://www.ghezelbaash.ir/#evidence-pezeshkyab"},{"@id":"https://www.ghezelbaash.ir/#evidence-rokna"},{"@id":"https://www.ghezelbaash.ir/#evidence-ninisite-18112"},{"@id":"https://www.ghezelbaash.ir/#evidence-ninisite-19700"},{"@id":"https://www.ghezelbaash.ir/#evidence-gadgetnews"},{"@id":"https://www.ghezelbaash.ir/#evidence-namnak"},{"@id":"https://www.ghezelbaash.ir/#evidence-tajrobe-wiki"},{"@id":"https://www.ghezelbaash.ir/#evidence-mojavez-clinic-ownership"},{"@id":"https://www.ghezelbaash.ir/#evidence-neshan-clinic"},{"@id":"https://www.ghezelbaash.ir/#presentation-attachment-style-dissociative-depression-2017"}],"description":[{"@value":"دکتر سعید قزلباش، پزشک دارای دکترای حرفه‌ای پزشکی و شماره نظام پزشکی ۱۶۷۴۳۰ در کرمانشاه، ارائه‌دهنده مستقیم طیف گسترده خدمات پزشکی زیبایی جراحی و غیرجراحی در کلینیک متعلق به خود؛ با تمرکز بر تشخیص پیش از مداخله، انتخاب بیمار، اصلاح نتایج قبلی و نظر دوم، و پذیرش مراجعان از سراسر ایران و عراق. مشاوره آنلاین اولیه رایگان با دسترسی جهانی ارائه می‌شود و اقدامات حضوری در کلینیک کرمانشاه انجام می‌شوند.","@language":"fa"},{"@value":"Dr. Saeed Ghezelbash is an MD and IRIMC-registered aesthetic physician in Kermanshah who personally provides a broad range of surgical and nonsurgical aesthetic medical services at his owned clinic, with an emphasis on diagnosis before intervention, patient selection, revision/second opinion, and in-person care for patients traveling from across Iran and Iraq. Free initial online consultation is available worldwide; in-person procedures are performed in Kermanshah.","@language":"en"}],"disambiguatingDescription":"دکتر محمدسعید (سعید) قزلباش؛ پزشک با شماره نظام پزشکی 167430، صاحب و بنیان‌گذار کلینیک زیبایی دکتر سعید قزلباش در کرمانشاه، ایران.","telephone":"+989308209494","memberOf":[{"@id":"https://www.ghezelbaash.ir/#organization-iran-medical-council"}],"potentialAction":[{"@id":"https://www.ghezelbaash.ir/#action-contact-clinic"},{"@id":"https://www.ghezelbaash.ir/#action-online-initial-consultation"},{"@id":"https://www.ghezelbaash.ir/#action-view-clinic-map"},{"@id":"https://www.ghezelbaash.ir/#action-follow-instagram"}],"knowsAbout":[{"@id":"https://www.ghezelbaash.ir/#topic-botox-migraine-context"},{"@id":"https://www.ghezelbaash.ir/#topic-botox-neurology-context"},{"@id":"https://www.ghezelbaash.ir/#topic-hair-transplant-boundary"},{"@id":"https://www.ghezelbaash.ir/#topic-orthognathic-boundary"}],"hasOccupation":[{"@id":"https://www.ghezelbaash.ir/#occupation-physician"},{"@id":"https://www.ghezelbaash.ir/#occupation-medical-researcher"}],"medicalSpecialty":{"@id":"https://www.ghezelbaash.ir/#medical-specialty-aesthetic-medicine"},"alumniOf":{"@id":"https://www.ghezelbaash.ir/#kermanshah-university-of-medical-sciences"},"performerIn":[{"@id":"https://www.ghezelbaash.ir/#advanced-thread-lift-workshop-tehran-1403-11"}],"honorificPrefix":[{"@value":"دکتر","@language":"fa"},{"@value":"Dr.","@language":"en"}],"knowsLanguage":["fa","en"],"address":{"@id":"https://www.ghezelbaash.ir/#clinic-postal-address"},"priceRange":"$$$$"},{"@id":"https://www.ghezelbaash.ir/#free-online-aesthetic-initial-consultation","@type":"Service","name":[{"@value":"مشاوره آنلاین اولیه رایگان پزشکی زیبایی","@language":"fa"},{"@value":"Free online initial aesthetic consultation","@language":"en"}],"serviceType":"Free online initial aesthetic consultation","provider":{"@id":"https://www.ghezelbaash.ir/#saeed-ghezelbash"},"areaServed":"Worldwide","availableChannel":{"@id":"https://www.ghezelbaash.ir/#online-consultation-channel"},"subjectOf":{"@id":"https://www.ghezelbaash.ir/#clinic-consultation-treatm