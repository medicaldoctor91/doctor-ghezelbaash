{
  "name": "doctor-ghezelbaash",
  "version": "1.2.5",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.9.0",
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  },
  "scripts": {
    "security:dependencies": "node scripts/dependency-advisory-gate.mjs",
    "clean:generated": "node scripts/generated-workspace.mjs reset",
    "prepare:site": "npm run clean:generated && node scripts/generate-projections.mjs site",
    "prepare:distribution": "npm run clean:generated && npm run rdf:generate && node scripts/generate-projections.mjs distribution && node scripts/generate-retrieval-projections.mjs && node scripts/generate-descriptors.mjs",
    "dev": "npm run prepare:site && ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "check:astro": "ASTRO_TELEMETRY_DISABLED=1 astro check --minimumFailingSeverity warning",
    "check": "npm run prepare:site && npm run check:astro",
    "materialize:static": "node scripts/materialize-static-artifacts.mjs",
    "rdf:generate": "node scripts/generate-rdf.mjs",
    "indexnow:prepare": "node scripts/indexnow.mjs prepare",
    "compile:dist": "ASTRO_TELEMETRY_DISABLED=1 astro build && npm run materialize:static && npm run indexnow:prepare && node scripts/generate-deployment-headers.mjs",
    "build": "npm run prepare:distribution && npm run compile:dist",
    "release:attest": "node scripts/write-release-attestation.mjs",
    "release": "npm run build && npm run release:attest && npm run package:dist",
    "package:dist": "node scripts/package-dist.mjs",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "verify:subdomains": "node scripts/verify-production.mjs subdomains",
    "verify:production": "node scripts/verify-production.mjs full",
    "verify:public-discovery": "node scripts/verify-live.mjs discovery",
    "indexnow:submit": "node scripts/indexnow.mjs submit",
    "validate:reputation": "node scripts/reputation.mjs validate",
    "reputation:update": "node scripts/reputation.mjs google",
    "verify:mojavez": "node scripts/verify-mojavez-evidence.mjs",
    "validate:release-contract": "node scripts/validate-release-contract.mjs",
    "validate:source": "npm run check:astro"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "24.13.3",
    "astro": "7.2.8",
    "css-tree": "3.2.1",
    "csso": "5.0.5",
    "exiftool-vendored": "37.1.0",
    "jsonld": "9.0.0",
    "parse5": "8.0.1",
    "playwright": "1.63.0",
    "rdf-canonize": "5.0.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11.9 <12"
  }
}
